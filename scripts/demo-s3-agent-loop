SYNTHETIC_AWS_ENV = {
    'AWS_ACCESS_KEY_ID': 'AKIAIOSFODNN7DEMO001',
    'AWS_SECRET_ACCESS_KEY': 'synthetic-demo-secret-key-not-valid',
