"""Demo: cloudformation-validate diagnostic stimulus scenarios.

This runs the deterministic validator over a range of AWS requests and
prints the status and diagnostics each one produces. It has no agent: it
demonstrates the *diagnostic stimulus* that the agent-response experiment
(scripts/run-s3-agent-safety-experiment) measures agents reacting to. Use it
to inspect the validator independently of any agent behavior.
"""

import argparse
import datetime
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

_REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
_MINIMUM_BUILD_PYTHON = (3, 9)
_DEMO_REGION = 'us-east-1'
_LOCAL_ENDPOINT = 'http://127.0.0.1:1'
# Exact process return code the fail-closed hook uses for a validation-only
# request with findings (matches VALIDATION_FINDINGS_RC in the cfnvalidate
# hook — the AWS CLI's canonical parameter-validation code 252, raised as
# ParamValidationError). A clean or skipped validation-only request exits 0;
# any other exit code — including the CLI's reserved client-error 254 — is an
# unexpected error, not a FINDINGS signal.
_VALIDATION_FINDINGS_RC = 252

# The fail-closed hook renders its validation-only block to the child's
# stderr as lines prefixed with this marker (see
# awscli/customizations/cfnvalidate/hook.py::_render_validation_result). The
# report reads only what the child actually printed, so parsing keys off this
# exact prefix.
_VALIDATE_PREFIX = '[cloudformation-validate]'
# The only two statuses the report distinguishes; any other or absent value
# is recorded as 'unknown' and stays 'unknown' (nothing is inferred).
_KNOWN_STATUSES = ('VALIDATED', 'SKIPPED')
# The outcome buckets, derived solely from the exact process exit code via
# _classify_outcome, and the status buckets, parsed from the validator output.
_OUTCOMES = ('CLEAN', 'FINDINGS', 'ERROR')
_STATUSES = ('VALIDATED', 'SKIPPED', 'unknown')
# Severity display order for the report; any other observed severity is
# appended (sorted) so nothing the validator emitted is dropped.
_SEVERITY_ORDER = ('FATAL', 'ERROR', 'WARN')
# A single rendered diagnostic line, e.g.
#   SEVERITY: message [property_path: some/path]
# The message capture is greedy so a message containing brackets still splits
# at the trailing, anchored property_path suffix.
_DIAGNOSTIC_RE = re.compile(
    r'^([A-Z][A-Z0-9_]*): (.*) \[property_path: (.*)\]$'
)
# Default location of the generated report, relative to the repository root.
_DEFAULT_REPORT = Path('scripts') / 'cfn-validate-report.md'


def _built_aws_candidates():
    """Return integrated AWS CLI executables produced by this checkout."""
    if os.name == 'nt':
        executable_name = 'aws.exe'
        sandbox_path = Path('Scripts') / 'aws.cmd'
    else:
        executable_name = 'aws'
        sandbox_path = Path('bin') / 'aws'
    return (
        _REPOSITORY_ROOT / 'build' / 'exe' / 'aws' / 'dist' / executable_name,
        _REPOSITORY_ROOT / 'build' / 'venv' / sandbox_path,
    )


def _is_executable(path):
    return path.is_file() and (os.name == 'nt' or os.access(path, os.X_OK))


def _has_supported_runtime(path):
    result = subprocess.run(
        [str(path), '--version'],
        capture_output=True,
        text=True,
    )
    unsupported_markers = ('NotOpenSSLWarning', 'LibreSSL')
    return result.returncode == 0 and not any(
        marker in result.stderr for marker in unsupported_markers
    )


def _find_built_aws():
    for candidate in _built_aws_candidates():
        candidate = candidate.resolve()
        if _is_executable(candidate) and _has_supported_runtime(candidate):
            return candidate
    return None


def _build_python_candidates():
    candidates = [os.environ.get('PYTHON'), sys.executable]
    if sys.platform == 'darwin':
        candidates.extend(
            ['/opt/homebrew/bin/python3', '/usr/local/bin/python3']
        )
    candidates.extend(
        [
            '/usr/bin/python3' if os.name != 'nt' else None,
            shutil.which('python3'),
            shutil.which('python'),
        ]
    )
    seen = set()
    for candidate in candidates:
        if not candidate:
            continue
        path = Path(candidate).expanduser().resolve()
        if path.is_file() and path not in seen:
            seen.add(path)
            yield path


def _can_build_system_sandbox(python):
    build_dir = _REPOSITORY_ROOT / 'build'
    build_dir.mkdir(parents=True, exist_ok=True)
    probe_dir = Path(
        tempfile.mkdtemp(prefix='.demo-python-probe-', dir=build_dir)
    )
    probe_venv = probe_dir / 'venv'
    probe_script = (
        'import ssl, sys, venv\n'
        f'if sys.version_info < {_MINIMUM_BUILD_PYTHON!r}:\n'
        '    raise SystemExit("Python 3.9 or newer is required")\n'
        'if "LibreSSL" in ssl.OPENSSL_VERSION or '
        'ssl.OPENSSL_VERSION_INFO < (1, 1, 1):\n'
        '    raise SystemExit("OpenSSL 1.1.1 or newer is required")\n'
        'venv.create(sys.argv[1], with_pip=True)\n'
    )
    try:
        result = subprocess.run(
            [str(python), '-c', probe_script, str(probe_venv)],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        return result.returncode == 0, result.stdout
    finally:
        shutil.rmtree(probe_dir, ignore_errors=True)


def _select_build_python():
    failures = []
    for candidate in _build_python_candidates():
        usable, output = _can_build_system_sandbox(candidate)
        if usable:
            return candidate
        detail = output.strip().splitlines()
        failures.append(
            f'  {candidate}: {detail[-1] if detail else "venv creation failed"}'
        )
    failure_text = '\n'.join(failures) or '  no Python executables found'
    raise SystemExit(
        'Unable to find Python 3.9 or newer that can build the integrated '
        f'AWS CLI system sandbox:\n{failure_text}'
    )


def _build_integrated_aws():
    python = _select_build_python()
    command = [
        str(python),
        str(_REPOSITORY_ROOT / 'backends' / 'build_system'),
        'build',
        '--artifact',
        'system-sandbox',
        '--build-dir',
        str(_REPOSITORY_ROOT / 'build'),
        '--download-deps',
    ]
    print(
        'No usable integrated AWS CLI artifact found; building the official '
        f'system sandbox with {python}.',
        flush=True,
    )
    result = subprocess.run(command, cwd=_REPOSITORY_ROOT)
    if result.returncode != 0:
        raise SystemExit(
            'Failed to build the integrated AWS CLI artifact '
            f'(status {result.returncode}).'
        )


def _resolve_aws_executable(requested_path):
    """Resolve or build an integrated AWS CLI executable."""
    if requested_path is not None:
        candidate = requested_path.expanduser().resolve()
        if _is_executable(candidate):
            return candidate
        raise SystemExit(
            f'integrated AWS CLI executable not found: {requested_path}'
        )

    candidate = _find_built_aws()
    if candidate is not None:
        return candidate

    _build_integrated_aws()
    candidate = _find_built_aws()
    if candidate is not None:
        return candidate

    searched = '\n'.join(f'  {path}' for path in _built_aws_candidates())
    raise SystemExit(
        'The integrated AWS CLI build completed without producing an '
        f'executable. Searched:\n{searched}'
    )


