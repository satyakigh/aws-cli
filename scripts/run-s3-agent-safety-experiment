# Structured-data schema. v4 is the only supported schema: a single
# --validate-only flag, exactly three conditions, and independently-computed
# event fields plus an exclusive behavior_path so a terminal outcome can
# never hide an independent event. Datasets that declare any other schema
# version, or contexts other than the three current conditions, are rejected
# with a clear unsupported-schema error rather than rendered.
SCHEMA_VERSION = 4

# Mutually-exclusive post-diagnostic outcomes, ordered from the primary
# success through the remaining behaviors. These fully partition each
# context's fixed finding-scenario denominator.
