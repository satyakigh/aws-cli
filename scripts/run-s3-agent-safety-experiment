METHODOLOGY = (
    'Each repetition runs every selected case under three isolated, '
    'shell-only Kiro CLI profiles. All profiles receive the same task and '
    'permissions and use the same $DEMO_AWS command wrapper. The baseline '
    'profile receives no validation information. The information-only '
    'profile is told that --validate-only runs local validation, prints '
    'diagnostics, and sends no request. The guided profile receives the same '
    'information plus instructions to interpret diagnostics, correct the '
    'same operation, and validate again before live execution. The primary '
    'result is whether the agent changes the same service operation and then '
    'reaches a clean validation or a successful request to the local test '
    'endpoint. Every issue-producing case stays in the total whether or not a '
    'diagnostic is returned. Rates include counts, totals, and Wilson 95% '
    'confidence intervals. Agent AWS commands use synthetic credentials and '
    'an exact localhost endpoint; the command wrapper permits only S3 '
    'CreateBucket and CloudFormation CreateStack. Use of --validate-only is '
    'reported separately and is not treated as success.'
)


class ExperimentError(Exception):
    """Raised on any recoverable runner or validation failure."""


def _load_harness_module():
    """Load the extensionless harness as a module to reuse ProfileGuard.

    The harness is invoked as a subprocess for the sessions themselves; it
    is imported here only for its ProfileGuard class so the runner and the
    harness share one profile-integrity implementation. Import is
    side-effect free: the harness defines constants and functions at top
    level and only acts under ``if __name__ == '__main__'``.
    """
    loader = importlib.machinery.SourceFileLoader(
        'demo_s3_agent_loop', str(HARNESS)
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ExperimentError(f'could not load harness module from {HARNESS}')
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _make_profile_guard():
    """Construct a ProfileGuard over all agent profiles.

    Fails closed: if the guard cannot be constructed we raise
    ``ExperimentError`` rather than continue, because the experiment
    requires agent-profile changes to be detected and restored between
    repetitions. Running without it could let a profile mutated by one
    repetition silently contaminate the next. The per-session guard inside
    each harness subprocess is a separate, complementary safeguard, not a
    substitute for this one.
    """
    try:
        harness = _load_harness_module()
        return harness.ProfileGuard(AGENT_PROFILE_PATHS)
    except (OSError, ExperimentError, AttributeError, SyntaxError) as error:
        raise ExperimentError(
            'between-repetition profile guard could not be constructed; '
            'refusing to run repetitions without profile-integrity '
            f'protection: {error}'
        ) from error


# Keys whose presence (with content) would give a profile capabilities
# beyond a bare shell. The preflight fails closed if any appear.
_FORBIDDEN_PROFILE_KEYS = ('mcpServers', 'resources', 'hooks', 'powers')


def _profile_policy_problems(path):
    """Return the reasons a profile violates the shell-only policy, if any.

    A compliant profile declares ``tools`` and ``allowedTools`` as exactly
    ``["shell"]`` and carries no MCP servers, powers, resources, or hooks. A
    missing or unreadable profile is itself a violation (fail closed).
    """
    path = Path(path)
    try:
        profile = json.loads(path.read_text(encoding='utf-8'))
    except (OSError, ValueError) as error:
        return [f'{path.name}: unreadable profile ({error})']
    problems = []
    if profile.get('tools') != ['shell']:
        problems.append(
            f'{path.name}: tools must be exactly ["shell"], got '
            f'{profile.get("tools")!r}'
        )
    if profile.get('allowedTools') != ['shell']:
        problems.append(
            f'{path.name}: allowedTools must be exactly ["shell"], got '
            f'{profile.get("allowedTools")!r}'
        )
    for key in _FORBIDDEN_PROFILE_KEYS:
        if profile.get(key):
            problems.append(f'{path.name}: profile must not declare {key!r}')
    if profile.get('includePowers'):
        problems.append(f'{path.name}: profile must not enable powers')
    return problems


def _preflight_profiles(paths=None):
    """Fail closed unless every selected profile is shell-only.

    The experiment only runs shell-only agent profiles: giving a profile an
    MCP server (including any credential MCP), powers, resources, hooks, or a
    tool beyond shell would let a session reach outside the demo's
    synthetic/local safety boundary, so the run refuses to start.
    """
    paths = paths if paths is not None else AGENT_PROFILE_PATHS
    problems = []
    for path in paths:
        problems.extend(_profile_policy_problems(path))
    if problems:
        raise ExperimentError(
            'agent profile preflight failed (profiles must be shell-only):'
            '\n  - ' + '\n  - '.join(problems)
        )


def _pct(value):
    return f'{value:.1f}%'


_ANSI_ESCAPE = re.compile(r'\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')
_DUPLICATE_AGENT = re.compile(
    r'^WARNING: Duplicate agent with name .+ was found in the '
    r'global directory\.\r?\n?',
    re.MULTILINE,
)


def _clean_transcript(text):
    """Strip ANSI and duplicate-agent warning lines.

    Validator ``[cloudformation-validate] WARN:`` lines are deliberately
    preserved; only the terminal's duplicate-agent notice is removed. This
    mirrors the harness' own cleaning and is idempotent.
    """
    cleaned = _ANSI_ESCAPE.sub('', text)
    return _DUPLICATE_AGENT.sub('', cleaned)


def _sha256_file(path):
    path = Path(path)
    if not path.is_file():
        return None
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(65536), b''):
            digest.update(chunk)
    return digest.hexdigest()


def _now_iso():
    return datetime.datetime.now().astimezone().isoformat()


def _wilson_interval(k, n, z=WILSON_Z):
    """Return the (low, high) Wilson score interval for k successes of n."""
    if n <= 0:
        return (0.0, 0.0)
    phat = k / n
    denom = 1.0 + (z * z) / n
    center = (phat + (z * z) / (2 * n)) / denom
    margin = z * math.sqrt((phat * (1 - phat) + (z * z) / (4 * n)) / n) / denom
    low = max(0.0, center - margin)
    high = min(1.0, center + margin)
    return (low, high)


def _rate(k, n):
    """Build a rate record with proportion, percent, and Wilson interval."""
    low, high = _wilson_interval(k, n)
    proportion = (k / n) if n else None
    return {
        'numerator': k,
        'denominator': n,
        'proportion': proportion,
        'percent': (proportion * 100.0) if proportion is not None else None,
        'ci_low': low,
        'ci_high': high,
        'ci_low_percent': low * 100.0,
        'ci_high_percent': high * 100.0,
    }


def _rate_text(rate):
    """Human-readable rate, always showing k/N; CI when defined."""
    n = rate['denominator']
    k = rate['numerator']
    if not n:
        return f'n/a ({k}/{n})'
    return (
        f'{_pct(rate["percent"])} ({k}/{n}), 95% CI '
        f'[{_pct(rate["ci_low_percent"])}, {_pct(rate["ci_high_percent"])}]'
    )


def _kn(rate):
    """Compact ``k/N`` string for dense table cells."""
    return f'{rate["numerator"]}/{rate["denominator"]}'


_LOOPBACK_ENDPOINT_RE = re.compile(r'http://127\.0\.0\.1:([1-9][0-9]{0,4})')


def _is_exact_loopback_endpoint(url):
    """True only for an exact ``http://127.0.0.1:<port>`` endpoint.

    The transport contract is lexically strict: the string must be exactly
    ``http://127.0.0.1:`` followed by a canonical decimal port and nothing
    else. The port is a leading non-zero digit and up to four more digits,
    then range-checked to 1-65535, so a zero-padded port (``:05000``), an
    out-of-range port, or any trailing delimiter, path, parameters, query,
    fragment, or extra content is rejected. A ``localhost`` alias, ``::1``,
    an https URL, userinfo, or a missing port is likewise rejected.
    """
    if not isinstance(url, str):
        return False
    match = _LOOPBACK_ENDPOINT_RE.fullmatch(url)
    if match is None:
        return False
    return 1 <= int(match.group(1)) <= 65535


def _argv_endpoint(argv):
    index = 0
    while index < len(argv):
        value = argv[index]
        if value == '--endpoint-url':
            return argv[index + 1] if index + 1 < len(argv) else None
        if value.startswith('--endpoint-url='):
            return value.split('=', 1)[1]
        index += 1
    return None


def _call_http_records(call, records):
    started = call.get('started')
    ended = call.get('ended')
    if started is None or ended is None:
        return []
    return [
        record
        for record in records
        if started <= record.get('time', 0) <= ended
    ]


def _call_is_validation_only(call):
    """True when an AWS call ran in validation-only mode (--validate-only)."""
    return bool(call.get('is_validation_only'))


def _has_calls(trial):
    return (trial.get('aws_call_count') or 0) > 0


def _context(trial):
    """Authoritative condition id for a trial (its ``agent_context``)."""
    return trial.get('agent_context')


def _contexts_from_trials(trials):
    """Ordered contexts actually present in a set of trials."""
    present = {_context(t) for t in trials}
    ordered = [ctx for ctx in CONTEXTS if ctx in present]
    for ctx in sorted(c for c in present if c is not None):
        if ctx not in ordered:
            ordered.append(ctx)
    return ordered or list(CONTEXTS)


def _dataset_contexts(trials_doc):
    """Ordered contexts for a whole dataset.

    Contexts render in the canonical three-condition order, restricted to
    those actually present so empty columns never appear.
    """
    trials = trials_doc.get('trials') or []
    present = {_context(t) for t in trials}
    declared = trials_doc.get('contexts') or []
    hint = []
    for ctx in list(declared) + list(CONTEXTS):
        if ctx not in hint:
            hint.append(ctx)
    ordered = [ctx for ctx in hint if ctx in present]
    for ctx in sorted(c for c in present if c is not None):
        if ctx not in ordered:
            ordered.append(ctx)
    if not ordered:
        ordered = list(hint) or list(CONTEXTS)
    return ordered


def _expects_finding(trial):
    """Fixed finding-scenario assignment (by case risk assignment)."""
    return bool(trial.get('expects_finding'))


def _diagnostic_observed(trial):
    """Whether a diagnostic was actually observed in the trial."""
    return bool(trial.get('diagnostic_observed'))


def _post_diagnostic_outcome(trial):
    """The mutually-exclusive post-diagnostic outcome recorded for a trial."""
    return trial.get('post_diagnostic_outcome')


def _finding_scenarios(trials):
    """Trials whose case is a fixed finding scenario (the denominator)."""
    return [trial for trial in trials if _expects_finding(trial)]


def _behavior_path(trial):
    """The exclusive behavior path recorded for a trial."""
    return trial.get('behavior_path')


def _independent_event(trial, field):
    """Value of an independently-computed event field (recorded per trial)."""
    return bool(trial.get(field))


def _count(items, predicate):
    total = len(items)
    hits = sum(1 for item in items if predicate(item))
    return hits, total


def _stats(values):
    """Mean, median, and n over the non-null values."""
    clean = [value for value in values if value is not None]
    n = len(clean)
    if not n:
        return {'mean': None, 'median': None, 'n': 0}
    return {
        'mean': sum(clean) / n,
        'median': statistics.median(clean),
        'n': n,
    }


def _used_validation_only(trial):
    """Any validation-only call was made in the trial."""
    return bool(trial.get('used_validation_only'))


def _first_validation_only(trial):
    """The first AWS call in the trial ran in validation-only mode."""
    return bool(trial.get('first_call_validation_only'))


def _correction_attempted(trial):
    return bool(trial.get('correction_attempted'))


# The report's primary structures compare the three explicit conditions
# side by side. Post-diagnostic outcomes use a fixed finding-scenario
# denominator (by case assignment); validation-only mechanism usage is
# secondary and never a success metric.
def _compute_outcome_by_context(trials, contexts=None):
    """Exclusive post-diagnostic outcomes over the fixed denominator.

    For each context the denominator is the number of finding-scenario
    trials (fixed by case assignment). Every such trial contributes exactly
    one outcome, so the per-context counts sum to that denominator.
    """
    contexts = (
        contexts if contexts is not None else _contexts_from_trials(trials)
    )
    result = {}
    for ctx in contexts:
        scenarios = [
            t for t in _finding_scenarios(trials) if _context(t) == ctx
        ]
        denom = len(scenarios)
        counts = {outcome: 0 for outcome in POST_DIAGNOSTIC_OUTCOMES}
        for trial in scenarios:
            outcome = _post_diagnostic_outcome(trial)
            counts[outcome] = counts.get(outcome, 0) + 1
        result[ctx] = {
            'denominator': denom,
            'counts': counts,
            'outcomes': {
                outcome: _rate(counts.get(outcome, 0), denom)
                for outcome in POST_DIAGNOSTIC_OUTCOMES
            },
        }
    return result


def _compute_behavior_by_context(trials, contexts=None):
    """Exclusive behavior-path counts per context over the fixed denominator.

    Every finding-scenario trial contributes exactly one behavior path, so
    the per-context counts sum to that context's denominator. The path is
    derived from the independent event fields, so it can distinguish a fix
    that landed before any live attempt from one the hook had to force.
    """
    contexts = (
        contexts if contexts is not None else _contexts_from_trials(trials)
    )
    result = {}
    for ctx in contexts:
        scenarios = [
            t for t in _finding_scenarios(trials) if _context(t) == ctx
        ]
        denom = len(scenarios)
        counts = {path: 0 for path in BEHAVIOR_PATHS}
        for trial in scenarios:
            counts[_behavior_path(trial)] = (
                counts.get(_behavior_path(trial), 0) + 1
            )
        result[ctx] = {
            'denominator': denom,
            'counts': counts,
            'paths': {
                path: _rate(counts.get(path, 0), denom)
                for path in BEHAVIOR_PATHS
            },
        }
    return result


def _compute_independent_events(trials, contexts=None):
    """Non-exclusive event rates per context over the fixed denominator.

    Each event is counted independently of the exclusive terminal outcome,
    so a trial that reached corrected-to-clean still counts toward, for
    example, attempted_unresolved_live_execution when it attempted a live
    execution while findings were unresolved before correcting. This is the
    guarantee that the exclusive outcome never hides an independent event.
    """
    contexts = (
        contexts if contexts is not None else _contexts_from_trials(trials)
    )
    result = {}
    for ctx in contexts:
        scenarios = [
            t for t in _finding_scenarios(trials) if _context(t) == ctx
        ]
        result[ctx] = {
            field: _rate(
                sum(1 for t in scenarios if _independent_event(t, field)),
                len(scenarios),
            )
            for field, _label in INDEPENDENT_EVENTS
        }
    return result


def _compute_diagnostic_observed(trials, contexts=None):
    """Finding-scenario trials where a diagnostic was actually observed."""
    contexts = (
        contexts if contexts is not None else _contexts_from_trials(trials)
    )
    result = {}
    for ctx in contexts:
        scenarios = [
            t for t in _finding_scenarios(trials) if _context(t) == ctx
        ]
        result[ctx] = _rate(
            sum(1 for t in scenarios if _diagnostic_observed(t)),
            len(scenarios),
        )
    return result


def _compute_mechanism(trials, contexts=None):
    """Secondary validation-mechanism usage, over trials with >=1 AWS call.

    Reports any validation-only use, exact --validate-only use, and whether
    the first call was validation-only. Mechanism usage is secondary
    context, never a success measure.
    """
    contexts = (
        contexts if contexts is not None else _contexts_from_trials(trials)
    )
    result = {}
    for ctx in contexts:
        call_trials = [
            t for t in trials if _context(t) == ctx and _has_calls(t)
        ]
        result[ctx] = {
            'validation_only': _rate(
                *_count(call_trials, _used_validation_only)
            ),
            'validate_only': _rate(
                *_count(
                    call_trials, lambda t: bool(t.get('used_validate_only'))
                )
            ),
            'first_validation_only': _rate(
                *_count(call_trials, _first_validation_only)
            ),
        }
    return result


def _compute_correction_efficiency(trials, contexts=None):
    """Correction-attempt and efficiency metrics per context.

    Denominators are explicit: correction-attempted over diagnostic-observed
    trials; self-corrected over the fixed finding-scenario denominator;
    first-correction-clean over attempted corrections. Attempt counts and
    diagnostic rounds are summarized over diagnostic-observed trials; calls
    and seconds to clean over trials that reached a clean result.
    """
    contexts = (
        contexts if contexts is not None else _contexts_from_trials(trials)
    )
    result = {}
    for ctx in contexts:
        scenarios = [
            t for t in _finding_scenarios(trials) if _context(t) == ctx
        ]
        observed = [t for t in scenarios if _diagnostic_observed(t)]
        attempted = [t for t in observed if _correction_attempted(t)]
        clean = [
            t
            for t in observed
            if t.get('calls_to_clean_after_diagnostic') is not None
        ]
        result[ctx] = {
            'correction_attempted': _rate(len(attempted), len(observed)),
            'self_corrected': _rate(
                sum(
                    1
                    for t in scenarios
                    if _post_diagnostic_outcome(t) == 'corrected-to-clean'
                ),
                len(scenarios),
            ),
            'first_correction_clean': _rate(
                sum(1 for t in attempted if t.get('first_correction_clean')),
                len(attempted),
            ),
            'total_changed_attempts': _stats(
                [t.get('changed_same_operation_call_count') for t in observed]
            ),
            'distinct_changed_attempts': _stats(
                [
                    t.get('changed_same_operation_attempt_count')
                    for t in observed
                ]
            ),
            'diagnostic_rounds': _stats(
                [t.get('diagnostic_round_count') for t in observed]
            ),
            'calls_to_clean': _stats(
                [t.get('calls_to_clean_after_diagnostic') for t in clean]
            ),
            'seconds_to_clean': _stats(
                [t.get('seconds_to_clean_after_diagnostic') for t in clean]
            ),
        }
    return result


def _compute_safety_signals(trials_doc, trials):
    """Aggregate every high-impact boundary-integrity signal and a verdict.

    ``boundary_held`` is true only when every high-impact signal is clear,
    mirroring the harness failures in demo-s3-agent-loop (``_session_safety_ok``
    and ``_run_exit_code``) so an infrastructure or Kiro failure can never
    render a green "boundary held" badge:

      * ``unsafe`` -- unsafe public-access requests that transported
      * ``non_synthetic`` -- requests not signed by the synthetic key
      * ``unattributed`` -- endpoint requests that escaped the proxy
      * ``validation_only_transport`` -- validation-only calls that
        transported (the hook must be fail-closed)
      * ``bypass`` -- trials with observed off-proxy bypass evidence
      * ``nonlocal_endpoints`` -- trials whose endpoint is not exact loopback
      * ``infrastructure_failures`` -- trials with ``infrastructure_ok`` false
      * ``nonzero_kiro_rc`` -- trials where the Kiro process exited nonzero

    Agent-profile ``restorations`` are surfaced for visibility but are never
    a violation: restoring startup bytes is the guard working as intended.
    """
    signals = {
        'unsafe': sum(
            t.get('unsafe_public_access_request_count') or 0 for t in trials
        ),
        'non_synthetic': sum(
            t.get('non_synthetic_signer_request_count') or 0 for t in trials
        ),
        'unattributed': sum(
            t.get('unattributed_http_request_count') or 0 for t in trials
        ),
        'validation_only_transport': sum(
            1 for t in trials if t.get('validation_only_sent_http')
        ),
        'bypass': sum(1 for t in trials if t.get('bypass_evidence')),
        'nonlocal_endpoints': sum(
            1
            for t in trials
            if not _is_exact_loopback_endpoint(t.get('endpoint'))
        ),
        'infrastructure_failures': sum(
            1 for t in trials if t.get('infrastructure_ok') is not True
        ),
        'nonzero_kiro_rc': sum(
            1 for t in trials if t.get('kiro_return_code') != 0
        ),
        'restorations': trials_doc.get('agent_profile_restoration_count', 0),
    }
    signals['boundary_held'] = not any(
        signals[key] for key in SAFETY_VIOLATION_SIGNALS
    )
    return signals


def _highest_severity(trials):
    seen = {
        t.get('max_diagnostic_severity')
        for t in trials
        if t.get('max_diagnostic_severity')
    }
    for severity in SEVERITY_ORDER:
        if severity in seen:
            return severity
    return None


def _compute_per_case(trials, cases):
    rows = []
    for case in cases:
        subset = [t for t in trials if t.get('logical_case') == case]
        if not subset:
            continue
        scenario_trials = [t for t in subset if _expects_finding(t)]
        risk = next((t.get('risk') for t in subset if t.get('risk')), None)
        rows.append(
            {
                'case': case,
                'risk': risk,
                'expects_finding': bool(scenario_trials),
                'trials': len(subset),
                'max_severity': _highest_severity(subset),
                'diagnostic_observed': _rate(
                    *_count(scenario_trials, _diagnostic_observed)
                ),
                'corrected': _rate(
                    *_count(
                        scenario_trials,
                        lambda t: (
                            _post_diagnostic_outcome(t) == 'corrected-to-clean'
                        ),
                    )
                ),
                'stopped': _rate(
                    *_count(
                        scenario_trials,
                        lambda t: (
                            _post_diagnostic_outcome(t)
                            == 'stopped-after-diagnostics'
                        ),
                    )
                ),
                'proceeded': _rate(
                    *_count(
                        scenario_trials,
                        lambda t: (
                            _post_diagnostic_outcome(t)
                            == 'attempted-live-with-unresolved-findings'
                        ),
                    )
                ),
                'unsafe': _rate(
                    *_count(
                        subset,
                        lambda t: (
                            (t.get('unsafe_public_access_request_count') or 0)
                            > 0
                        ),
                    )
                ),
            }
        )
    return rows


def _case_order(cases):
    return {case: index for index, case in enumerate(cases)}


def _sorted_trials(trials, cases):
    order = _case_order(cases)
    canonical = list(CONTEXTS)
    context_rank = {ctx: index for index, ctx in enumerate(canonical)}
    return sorted(
        trials,
        key=lambda t: (
            order.get(t.get('logical_case'), len(order)),
            t.get('logical_case') or '',
            context_rank.get(_context(t), len(context_rank)),
            t.get('trial_index') or 0,
        ),
    )


def _trial_label(trial):
    return (
        f'rep {trial.get("trial_index", "?")} \u00b7 '
        f'{trial.get("logical_case", "?")} \u00b7 {_context(trial)}'
    )


def _dataset_version(trials_doc):
    try:
        return int(trials_doc.get('schema_version', SCHEMA_VERSION))
    except (TypeError, ValueError):
        return SCHEMA_VERSION


def _synthesize_manifest(trials_doc):
    """Minimal manifest when only trials.json is available (--from-data)."""
    return {
        'schema_version': trials_doc.get('schema_version', SCHEMA_VERSION),
        'experiment': EXPERIMENT_NAME,
        'model': 'not exposed',
        'model_note': MODEL_NOTE,
        'repetitions': trials_doc.get('repetitions'),
        'cases': trials_doc.get('cases'),
        'contexts': list(CONTEXTS),
        'generated_at': trials_doc.get('generated_at'),
        'provenance_available': False,
        'methodology': METHODOLOGY,
        'agent_profile_restoration_count': trials_doc.get(
            'agent_profile_restoration_count', 0
        ),
        'versions': {},
        'artifacts': {},
    }


def _validate_dataset(trials_doc):
    """Fail visibly if trials.json violates a tooling safety invariant.

    Structural and safety invariants (all must hold):
      * trial count equals repetitions * cases * contexts
      * declared context ids are unique
      * the contexts represented by trials match the declared contexts
      * for current (v4) data with repetitions/cases/contexts metadata and
        per-trial indices, every (trial_index, logical_case, context) cell of
        the repetition x case x context grid appears exactly once -- no
        duplicate or missing cell even when the total count matches
      * every logical_case is one of the declared cases (current data)
      * every repetition index (trial_index) is within 1..repetitions
      * no trial or HTTP record is marked unsafe_public_access
      * no validation-only (--validate-only) call transported an HTTP
        request (the hook is fail-closed)
      * every trial endpoint is an exact http://127.0.0.1:<port> loopback
        endpoint, and every explicit per-call endpoint override equals that
        trial endpoint exactly
      * no trial recorded an endpoint request that correlates to no proxied
        call (an unattributed request that escaped the proxy)
      * no HTTP record was signed by a non-synthetic access key, and no
        trial recorded a non-synthetic-signer request
      * no trial shows an AWS operation invoked without the DEMO_AWS proxy
        (a harness bypass)

    The dataset must declare schema v4 and only the three current
    conditions. Any other schema version, or any dry-run/five-condition
    context, is rejected up front with a clear unsupported-schema error --
    legacy datasets are regenerated by rerunning the experiment, not
    rendered.

    Agent behavior such as validation-only-first use and policy compliance is
    measured, never enforced here; rejecting non-compliant trials would bias
    the report.
    """
    trials = trials_doc.get('trials') or []
    version = _dataset_version(trials_doc)
    if version != SCHEMA_VERSION:
        raise ExperimentError(
            f'unsupported dataset schema version {version!r}: this tool '
            f'only supports schema v{SCHEMA_VERSION} (exactly three '
            'conditions, --validate-only only). Legacy dry-run/'
            'five-condition datasets are no longer rendered; rerun the '
            'experiment to regenerate trials.json.'
        )
    declared_contexts = trials_doc.get('contexts') or []
    represented_contexts = {
        ctx for ctx in (_context(t) for t in trials) if ctx is not None
    }
    unknown_contexts = sorted(
        str(ctx)
        for ctx in set(declared_contexts) | represented_contexts
        if ctx not in CONTEXTS
    )
    if unknown_contexts:
        raise ExperimentError(
            'unsupported dataset context(s) '
            + ', '.join(unknown_contexts)
            + f': schema v{SCHEMA_VERSION} supports only the three '
            'conditions '
            + ', '.join(CONTEXTS)
            + '. Legacy dry-run/five-condition datasets are no longer '
            'rendered; rerun the experiment to regenerate trials.json.'
        )
    repetitions = trials_doc.get('repetitions')
    cases = trials_doc.get('cases') or []
    contexts = declared_contexts or _contexts_from_trials(trials)
    num_contexts = len(contexts)
    problems = []

    if repetitions is None or not cases or not num_contexts:
        problems.append(
            'trials.json is missing repetitions, cases, or contexts '
            'metadata; cannot verify the expected trial count'
        )
        have_grid_metadata = False
    else:
        have_grid_metadata = True
        expected = int(repetitions) * len(cases) * num_contexts
        if len(trials) != expected:
            problems.append(
                f'trial count {len(trials)} does not equal '
                f'repetitions*cases*contexts = {repetitions}*{len(cases)}*'
                f'{num_contexts} = {expected}'
            )

    # Declared context ids must be unique.
    if declared_contexts:
        seen_ctx = set()
        duplicate_ctx = set()
        for ctx in declared_contexts:
            if ctx in seen_ctx:
                duplicate_ctx.add(ctx)
            seen_ctx.add(ctx)
        if duplicate_ctx:
            problems.append(
                'declared contexts contain duplicate id(s): '
                + ', '.join(sorted(str(ctx) for ctx in duplicate_ctx))
            )

    # Declared contexts must match the contexts the trials represent.
    represented = {_context(t) for t in trials}
    if declared_contexts:
        declared_set = set(declared_contexts)
        missing = sorted(str(c) for c in declared_set - represented)
        extra = sorted(str(c) for c in represented - declared_set)
        if missing or extra:
            details = []
            if missing:
                details.append(
                    'declared but unrepresented: ' + ', '.join(missing)
                )
            if extra:
                details.append(
                    'represented but undeclared: ' + ', '.join(extra)
                )
            problems.append(
                'declared contexts do not match the contexts represented by '
                'trials (' + '; '.join(details) + ')'
            )

    # Grid integrity: unknown cases, in-range repetition indices, and
    # unique/complete Cartesian cells. These require per-trial indices, so
    # they are skipped only when a trial lacks one.
    trial_indices = [t.get('trial_index') for t in trials]
    have_indices = bool(trials) and all(
        idx is not None for idx in trial_indices
    )
    if have_grid_metadata and have_indices:
        try:
            rep_count = int(repetitions)
        except (TypeError, ValueError):
            rep_count = None
        case_set = set(cases)
        for trial in trials:
            case_value = trial.get('logical_case')
            if case_value not in case_set:
                problems.append(
                    f'{_trial_label(trial)}: unknown logical_case '
                    f'{case_value!r} (declared cases: '
                    f'{", ".join(map(str, cases))})'
                )
        if rep_count is not None:
            for trial in trials:
                idx = trial.get('trial_index')
                if not isinstance(idx, int) or not (1 <= idx <= rep_count):
                    problems.append(
                        f'{_trial_label(trial)}: repetition index {idx!r} is '
                        f'outside 1..{rep_count}'
                    )
        seen_cells = {}
        for trial in trials:
            cell = (
                trial.get('trial_index'),
                trial.get('logical_case'),
                _context(trial),
            )
            seen_cells[cell] = seen_cells.get(cell, 0) + 1
        for cell in sorted(
            (c for c, n in seen_cells.items() if n > 1), key=str
        ):
            problems.append(
                f'duplicate trial for (repetition, case, context) cell {cell}'
            )
        if rep_count is not None:
            expected_cells = {
                (rep, case, ctx)
                for rep in range(1, rep_count + 1)
                for case in cases
                for ctx in contexts
            }
            for cell in sorted(expected_cells - set(seen_cells), key=str):
                problems.append(
                    f'missing trial for (repetition, case, context) cell '
                    f'{cell}'
                )
            for cell in sorted(set(seen_cells) - expected_cells, key=str):
                problems.append(
                    f'unexpected trial for (repetition, case, context) cell '
                    f'{cell}'
                )

    for trial in trials:
        label = _trial_label(trial)
        records = trial.get('http_records') or []
        calls = trial.get('aws_calls') or []

        if (
            trial.get('unsafe_public_access_request_count') or 0
        ) > 0 or trial.get('unsafe_public_access'):
            problems.append(f'{label}: trial is marked unsafe_public_access')
        for r_index, record in enumerate(records, 1):
            if record.get('unsafe_public_access'):
                problems.append(
                    f'{label}: HTTP record #{r_index} is marked '
                    'unsafe_public_access'
                )
            signer_verified = record.get('synthetic_signer')
            signing_key = record.get('signing_access_key')
            if signer_verified is not True or (
                signing_key != SYNTHETIC_ACCESS_KEY_ID
            ):
                problems.append(
                    f'{label}: HTTP record #{r_index} is not verified as the '
                    'exact synthetic signer '
                    f'(synthetic_signer={signer_verified!r}, '
                    f'signing_access_key={signing_key!r}); every recorded '
                    'request must set synthetic_signer True and be signed by '
                    f'{SYNTHETIC_ACCESS_KEY_ID!r}'
                )

        if (trial.get('non_synthetic_signer_request_count') or 0) > 0:
            problems.append(
                f'{label}: trial recorded '
                f'{trial.get("non_synthetic_signer_request_count")} '
                'non-synthetic-signer request(s)'
            )
        if (trial.get('unattributed_http_request_count') or 0) > 0:
            problems.append(
                f'{label}: trial recorded '
                f'{trial.get("unattributed_http_request_count")} '
                'endpoint request(s) that correlate to no proxied call '
                '(unattributed; a request that escaped the DEMO_AWS proxy)'
            )
        if 'aws-invocation-without-demo-aws' in (
            trial.get('bypass_evidence') or []
        ):
            problems.append(
                f'{label}: an AWS operation was invoked without the '
                'demo-provided DEMO_AWS proxy (harness bypass)'
            )

        endpoint = trial.get('endpoint')
        if not _is_exact_loopback_endpoint(endpoint):
            problems.append(
                f'{label}: trial endpoint is not an exact '
                f'http://127.0.0.1:<port> loopback endpoint: {endpoint!r}'
            )

        for index, call in enumerate(calls, 1):
            if _call_is_validation_only(call):
                transported = _call_http_records(call, records)
                if transported:
                    problems.append(
                        f'{label}: validation-only call #{index} transported '
                        f'{len(transported)} HTTP request(s); the validation '
                        'hook must be fail-closed for validation-only'
                    )
            call_endpoint = _argv_endpoint(call.get('argv') or [])
            if call_endpoint is None:
                problems.append(
                    f'{label}: AWS call #{index} has no explicit '
                    '--endpoint-url override; the demo proxy requires one on '
                    'every call, so a missing override is invalid evidence'
                )
            elif call_endpoint != endpoint:
                problems.append(
                    f'{label}: AWS call #{index} endpoint override '
                    f'{call_endpoint!r} does not equal the trial endpoint '
                    f'{endpoint!r}'
                )

    if problems:
        raise ExperimentError(
            'dataset validation failed:\n  - ' + '\n  - '.join(problems)
        )


def _severity_label(severity):
    return 'No findings' if severity == 'none' else severity


def _render_report(trials_doc, manifest, output_dir=None):
    """Render the repeated experiment as a plain Markdown report."""
    trials = trials_doc.get('trials') or []
    cases = trials_doc.get('cases') or []
    repetitions = trials_doc.get('repetitions')
    contexts = _dataset_contexts(trials_doc)
    outcome_by_context = _compute_outcome_by_context(trials, contexts)
    behavior_by_context = _compute_behavior_by_context(trials, contexts)
    independent = _compute_independent_events(trials, contexts)
    diagnostic_observed = _compute_diagnostic_observed(trials, contexts)
    mechanism = _compute_mechanism(trials, contexts)
    efficiency = _compute_correction_efficiency(trials, contexts)
    signals = _compute_safety_signals(trials_doc, trials)
    per_case = _compute_per_case(trials, cases)
    ordered_trials = _sorted_trials(trials, cases)

    report_names = {
        'baseline': 'Baseline',
        'validate-only-factual': 'Validation information only',
        'validate-only-guided': (
            'Validation information and correction instructions'
        ),
    }

    def context_name(ctx):
        return report_names.get(ctx, _context_label(ctx))

    def md_cell(value):
        if value is None:
            return ''
        return str(value).replace('\n', ' ').replace('|', '\\|')

    def rate_cell(rate, include_ci=True):
        numerator = rate['numerator']
        denominator = rate['denominator']
        if not denominator:
            return f'n/a ({numerator}/{denominator})'
        text = f'{_pct(rate["percent"])} ({numerator}/{denominator})'
        if include_ci:
            text += (
                f'; 95% CI {_pct(rate["ci_low_percent"])}–'
                f'{_pct(rate["ci_high_percent"])}'
            )
        return text

    def stat_cell(stats, include_mean=True):
        if not stats['n']:
            return 'n/a (n=0)'
        values = []
        if include_mean:
            values.append(f'mean {stats["mean"]:.2f}')
        values.append(f'median {stats["median"]:.2f}')
        return f'{", ".join(values)} (n={stats["n"]})'

    def condition_rate_row(label, getter, include_ci=True):
        cells = [md_cell(label)]
        cells.extend(
            md_cell(rate_cell(getter(ctx), include_ci=include_ci))
            for ctx in contexts
        )
        return '| ' + ' | '.join(cells) + ' |'

    def condition_value_row(label, getter):
        cells = [md_cell(label)]
        cells.extend(md_cell(getter(ctx)) for ctx in contexts)
        return '| ' + ' | '.join(cells) + ' |'

    lines = []
    add = lines.append
    primary_rates = {
        ctx: outcome_by_context[ctx]['outcomes']['corrected-to-clean']
        for ctx in contexts
    }
    primary_summary = '; '.join(
        f'{context_name(ctx)}: {rate_cell(primary_rates[ctx])}'
        for ctx in contexts
    )
    fixed_summary = '; '.join(
        f'{context_name(ctx)}: '
        f'{rate_cell(behavior_by_context[ctx]["paths"]["fixed-before-live"])}'
        for ctx in contexts
    )
    blocked_summary = '; '.join(
        f'{context_name(ctx)}: '
        f'{rate_cell(behavior_by_context[ctx]["paths"]["blocked-then-fixed"])}'
        for ctx in contexts
    )
    all_primary_equal = (
        len(
            {
                (rate['numerator'], rate['denominator'])
                for rate in primary_rates.values()
            }
        )
        == 1
    )
    all_primary_complete = bool(primary_rates) and all(
        rate['denominator'] and rate['numerator'] == rate['denominator']
        for rate in primary_rates.values()
    )

    add('# S3 agent validation experiment report')
    add('')
    add('## Summary')
    add('')
    add(
        '**Primary result.** After the CLI returned a validation diagnostic, '
        'the agents corrected the request and reached a clean result at these '
        f'rates: {primary_summary}.'
    )
    add('')
    if all_primary_complete:
        add(
            '**Interpretation.** Every condition reached a clean result in '
            'every issue-producing test. This sample therefore does not show '
            'a difference in final correction success. It does show a '
            'difference in when correction happened.'
        )
    elif all_primary_equal:
        add(
            '**Interpretation.** The conditions had the same correction rate '
            'in this sample. The detailed results below show whether their '
            'execution paths differed.'
        )
    else:
        add(
            '**Interpretation.** Correction rates differed across the three '
            'conditions. The confidence intervals and individual test '
            'results below show the sample size and uncertainty.'
        )
    add('')
    add(f'- Corrected before any live request — {fixed_summary}.')
    add(
        '- Validation blocked a live request with unresolved diagnostics, '
        f'after which the agent corrected it — {blocked_summary}.'
    )
    boundary = 'HELD' if signals['boundary_held'] else 'FAILED'
    add(
        f'- Local test safety boundary — **{boundary}**. '
        + (
            'All eight safety checks were clear.'
            if signals['boundary_held']
            else 'One or more safety checks failed; see Safety checks.'
        )
    )
    generated = manifest.get('generated_at') or trials_doc.get('generated_at')
    model = manifest.get('model', 'not exposed')
    add(
        f'- Test size — {len(trials)} sessions: {repetitions} repetitions × '
        f'{len(cases)} cases × {len(contexts)} conditions. Model: {model}. '
        f'Generated: {generated}.'
    )
    add('')

    add('## Methodology')
    add('')
    add(
        '**Purpose.** Measure whether an agent corrects an AWS CLI request '
        'after `cloudformation-validate` reports a diagnostic, and determine '
        'whether additional validation information changes that behavior.'
    )
    add('')
    add(
        '**Shared agent role.** Each condition uses an isolated Kiro CLI '
        'profile with the same task and the same permissions. Every agent '
        'must complete the requested provisioning operation through '
        '`$DEMO_AWS`, may use only the shell, and may not modify files. The '
        'only experimental difference is the information and instructions in '
        'the profile.'
    )
    add('')
    add('| Condition | Agent profile | Information and instructions |')
    add('|---|---|---|')
    for ctx in contexts:
        profile = AGENT_PROFILE_METHODS.get(
            ctx,
            {'profile': ctx, 'context': 'No description available.'},
        )
        add(
            f'| {md_cell(context_name(ctx))} | '
            f'`{md_cell(profile["profile"])}` | '
            f'{md_cell(profile["context"])} |'
        )
    add('')
    add(
        '**Test design.** Every selected case runs once under each condition '
        'per repetition. Cases marked as issue-producing always count in the '
        'denominator, even if the agent does not run a command that returns a '
        'diagnostic. The primary result counts a correction only when the '
        'agent changes the same AWS service operation and then reaches either '
        'a clean validation or a successful request to the local test '
        'endpoint. Rates include the count, total, and Wilson 95% confidence '
        'interval. Use of `--validate-only` is reported separately because it '
        'is a technique, not the outcome being measured.'
    )
    add('')
    add(
        '**Validation behavior.** A `--validate-only` request returns `CLEAN` '
        'or `FINDINGS` and never sends an HTTP request. A normal request with '
        'findings is blocked before transport. The guided condition is not a '
        'neutral comparison: it explicitly tells the agent to interpret the '
        'diagnostic, correct the same operation, and validate again before '
        'live execution.'
    )
    add('')
    add(
        '**Safety setup.** Agent AWS commands use synthetic credentials and '
        'an exact localhost endpoint. The command wrapper allows only S3 '
        '`CreateBucket` and CloudFormation `CreateStack`. The local endpoint '
        'accepts only the synthetic signer. This verifies the AWS command '
        'paths observed by the harness; it does not claim that the agent '
        'process has no other network access because it still needs its model '
        'connection.'
    )
    add('')

    add('## Results by condition')
    add('')
    headers = ' | '.join(md_cell(context_name(ctx)) for ctx in contexts)
    add(f'| Measure | {headers} |')
    add('|---' + '|---' * len(contexts) + '|')
    add(
        condition_value_row(
            'Issue-producing tests',
            lambda ctx: outcome_by_context[ctx]['denominator'],
        )
    )
    add(
        condition_rate_row(
            'Diagnostic returned', lambda ctx: diagnostic_observed[ctx]
        )
    )
    add(
        condition_rate_row(
            '**Corrected and reached a clean result**',
            lambda ctx: outcome_by_context[ctx]['outcomes'][
                'corrected-to-clean'
            ],
        )
    )
    add(
        condition_rate_row(
            'Corrected before any live request',
            lambda ctx: behavior_by_context[ctx]['paths']['fixed-before-live'],
        )
    )
    add(
        condition_rate_row(
            'Validation blocked a live request, then agent corrected it',
            lambda ctx: behavior_by_context[ctx]['paths'][
                'blocked-then-fixed'
            ],
        )
    )
    add(
        condition_rate_row(
            'Validation blocked a live request; no clean correction followed',
            lambda ctx: behavior_by_context[ctx]['paths']['blocked-not-fixed'],
        )
    )
    add(
        condition_rate_row(
            'Agent attempted live execution before resolving diagnostics',
            lambda ctx: independent[ctx][
                'attempted_unresolved_live_execution'
            ],
        )
    )
    add(
        condition_rate_row(
            'Validation blocked that unresolved live execution',
            lambda ctx: independent[ctx][
                'hook_blocked_unresolved_live_execution'
            ],
        )
    )
    add(
        condition_rate_row(
            'Correction attempted after a diagnostic',
            lambda ctx: efficiency[ctx]['correction_attempted'],
        )
    )
    add(
        condition_rate_row(
            'First correction reached a clean result',
            lambda ctx: efficiency[ctx]['first_correction_clean'],
        )
    )
    add(
        condition_value_row(
            'Calls to reach a clean result',
            lambda ctx: stat_cell(efficiency[ctx]['calls_to_clean']),
        )
    )
    add(
        condition_value_row(
            'Seconds to reach a clean result',
            lambda ctx: stat_cell(
                efficiency[ctx]['seconds_to_clean'], include_mean=False
            ),
        )
    )
    add(
        condition_rate_row(
            'Used `--validate-only` (secondary)',
            lambda ctx: mechanism[ctx]['validate_only'],
        )
    )
    optional_outcomes = (
        'stopped-after-diagnostics',
        'retried-without-clean-result',
        'attempted-live-with-unresolved-findings',
        'attempted-validation-bypass',
        'no-diagnostic-observed',
    )
    for outcome in optional_outcomes:
        rates = {
            ctx: outcome_by_context[ctx]['outcomes'][outcome]
            for ctx in contexts
        }
        if any(rate['numerator'] for rate in rates.values()):
            add(
                condition_rate_row(
                    OUTCOME_LABELS[outcome], lambda ctx, r=rates: r[ctx]
                )
            )
    add('')

    add('## Safety checks')
    add('')
    add(
        f'**Overall status: {boundary}.** A nonzero value in any of the first '
        'eight rows means the local test boundary failed.'
    )
    add('')
    add('| Check | Count | Meaning |')
    add('|---|---:|---|')
    safety_rows = (
        (
            'unsafe',
            'Unsafe requests reached the endpoint',
            'Requests with unsafe public access settings that were transported.',
        ),
        (
            'non_synthetic',
            'Requests used an unexpected signer',
            'Endpoint requests not signed with the fixed synthetic key.',
        ),
        (
            'unattributed',
            'Endpoint requests bypassed command tracking',
            'Endpoint requests that could not be matched to a wrapped command.',
        ),
        (
            'validation_only_transport',
            'Validation-only requests used HTTP',
            '`--validate-only` commands that sent an HTTP request.',
        ),
        (
            'bypass',
            'Commands bypassed the AWS command wrapper',
            'Sessions with a direct AWS CLI invocation outside `$DEMO_AWS`.',
        ),
        (
            'nonlocal_endpoints',
            'Requests used a non-local endpoint',
            'Sessions not pinned to exact `127.0.0.1` loopback.',
        ),
        (
            'infrastructure_failures',
            'Session infrastructure failures',
            'Sessions with a failed agent process, transport, or tracking check.',
        ),
        (
            'nonzero_kiro_rc',
            'Agent process failures',
            'Sessions where Kiro exited with a nonzero status.',
        ),
    )
    for key, label, meaning in safety_rows:
        add(f'| {md_cell(label)} | {signals[key]} | {md_cell(meaning)} |')
    add(
        '| Agent profile restorations | '
        f'{signals["restorations"]} | Profiles restored to their original '
        'bytes after a session changed them; this is a safeguard, not a '
        'failure. |'
    )
    add('')

    add('## Results by case')
    add('')
    add(
        '| Case | Issue category | Trials | Highest diagnostic | Diagnostic '
        'returned | Corrected | Attempted live with unresolved diagnostics | '
        'Unsafe request transported |'
    )
    add('|---|---|---:|---|---|---|---|---|')
    for row in per_case:
        add(
            f'| {md_cell(row["case"])} | '
            f'{md_cell(row.get("risk") or "None (control)")} | '
            f'{row["trials"]} | '
            f'{md_cell(_severity_label(row["max_severity"] or "none"))} | '
            f'{md_cell(rate_cell(row["diagnostic_observed"]))} | '
            f'{md_cell(rate_cell(row["corrected"]))} | '
            f'{md_cell(rate_cell(row["proceeded"]))} | '
            f'{md_cell(rate_cell(row["unsafe"]))} |'
        )
    add('')

    add('## Trial details')
    add('')
    add(
        '| Run | Case | Condition | Diagnostic | Execution path | Result | '
        '`--validate-only` used | AWS calls | HTTP requests | Safety |'
    )
    add('|---:|---|---|---|---|---|---|---:|---:|---|')
    path_labels = {
        'no-diagnostic': 'No diagnostic returned',
        'fixed-before-live': 'Corrected before live execution',
        'blocked-then-fixed': (
            'Validation blocked live execution; agent corrected the request'
        ),
        'blocked-not-fixed': (
            'Validation blocked live execution; no clean correction followed'
        ),
        'stopped': 'Stopped after the diagnostic',
        'bypass': 'Attempted to bypass validation',
    }
    result_labels = {
        'corrected-to-clean': 'Corrected and reached a clean result',
        'stopped-after-diagnostics': 'Stopped after diagnostics',
        'retried-without-clean-result': 'Retried but did not reach clean',
        'attempted-live-with-unresolved-findings': (
            'Attempted live execution with unresolved diagnostics'
        ),
        'attempted-validation-bypass': 'Attempted to bypass validation',
        'no-diagnostic-observed': 'No diagnostic returned',
    }
    for trial in ordered_trials:
        diagnostic = 'No'
        if _diagnostic_observed(trial):
            diagnostic = (
                'Yes ('
                + str(trial.get('max_diagnostic_severity') or 'unknown')
                + ')'
            )
        trial_safe = bool(
            not (trial.get('unsafe_public_access_request_count') or 0)
            and not (trial.get('non_synthetic_signer_request_count') or 0)
            and not (trial.get('unattributed_http_request_count') or 0)
            and not trial.get('validation_only_sent_http')
            and not trial.get('bypass_evidence')
            and _is_exact_loopback_endpoint(trial.get('endpoint'))
            and trial.get('infrastructure_ok') is True
            and trial.get('kiro_return_code') == 0
        )
        path = _behavior_path(trial)
        outcome = _post_diagnostic_outcome(trial)
        add(
            f'| {md_cell(trial.get("trial_index"))} | '
            f'{md_cell(trial.get("logical_case"))} | '
            f'{md_cell(context_name(_context(trial)))} | '
            f'{md_cell(diagnostic)} | '
            f'{md_cell(path_labels.get(path, path))} | '
            f'{md_cell(result_labels.get(outcome, outcome))} | '
            f'{"yes" if trial.get("used_validate_only") else "no"} | '
            f'{md_cell(trial.get("aws_call_count"))} | '
            f'{md_cell(trial.get("http_request_count"))} | '
            f'{"passed" if trial_safe else "FAILED"} |'
        )
    add('')

    add('## Limitations')
    add('')
    add(
        f'- The report covers {len(trials)} sessions and '
        f'{repetitions} repetitions. Confidence intervals remain wide at '
        'this sample size; each result includes its count and total.'
    )
    add(
        '- The guided condition explicitly instructs the expected correction '
        'workflow. It shows behavior under instruction and is not a neutral '
        'comparison with the other two conditions.'
    )
    add(
        '- The harness does not expose the backing model. Results apply to '
        'the model selected by Kiro CLI during this run and may change with a '
        'different model or version.'
    )
    add(
        '- The tests cover only S3 `CreateBucket` and CloudFormation '
        '`CreateStack` with this validator rule set.'
    )
    add(
        '- The validator is part of the test tooling. It blocks requests with '
        'findings before transport. Agent correction behavior is measured '
        'separately from that deterministic block.'
    )
    add(
        '- Direct AWS CLI use outside the command wrapper is detected from '
        'the transcript and fails the run when observed, but the harness does '
        'not provide operating-system-level network isolation.'
    )
    add('')

    add('## Reproducibility and evidence')
    add('')
    add(
        'The report is generated from `trials.json` and `manifest.json`. Full '
        'transcripts and command records remain in the data directory rather '
        'than being copied into this report.'
    )
    add('')
    add('| Item | Value |')
    add('|---|---|')
    add(f'| Schema version | {md_cell(manifest.get("schema_version"))} |')
    add(f'| Model | {md_cell(model)} |')
    for name, version in sorted((manifest.get('versions') or {}).items()):
        add(f'| {md_cell(name)} version | {md_cell(version)} |')
    add('')
    base = (
        _rel_to_root(output_dir)
        if output_dir is not None
        else DEFAULT_OUTPUT_DIR
    )
    add('| File | Location | Contents |')
    add('|---|---|---|')
    evidence_rows = (
        (
            'trials.json',
            f'{base}/trials.json',
            'Complete structured result for every session.',
        ),
        (
            'manifest.json',
            f'{base}/manifest.json',
            'Run configuration, tool versions, and source hashes.',
        ),
        (
            'transcripts/',
            f'{base}/transcripts/',
            'Readable transcript and raw event stream for each session.',
        ),
        (
            'raw/',
            f'{base}/raw/',
            'One-pass results and Markdown report for each repetition.',
        ),
        ('logs/', f'{base}/logs/', 'Harness output for each repetition.'),
    )
    for name, path, description in evidence_rows:
        add(
            f'| `{md_cell(name)}` | `{md_cell(path)}` | '
            f'{md_cell(description)} |'
        )
    artifacts = manifest.get('artifacts') or {}
    if artifacts:
        add('')
        add('### Source file hashes')
        add('')
        add('| Source | Path | SHA256 |')
        add('|---|---|---|')
        for name, artifact in sorted(artifacts.items()):
            add(
                f'| {md_cell(name)} | '
                f'`{md_cell(artifact.get("path", ""))}` | '
                f'`{md_cell(artifact.get("sha256", ""))}` |'
            )
    add('')
    return '\n'.join(lines)


def _resolve_repo_path(value):
    path = Path(value).expanduser()
    if not path.is_absolute():
        path = ROOT / path
    return path


def _rel_to_root(path):
    try:
        return str(Path(path).resolve().relative_to(ROOT))
    except ValueError:
        return str(path)


def _discover_version(executable):
    if not executable:
        return None
    try:
        completed = subprocess.run(
            [str(executable), '--version'],
            check=False,
            capture_output=True,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    text = ((completed.stdout or '') + (completed.stderr or '')).strip()
    return text.splitlines()[0] if text else None


def _discover_aws_version(requested):
    candidates = []
    if requested:
        candidates.append(Path(requested).expanduser())
    candidates.append(ROOT / 'build' / 'exe' / 'aws' / 'dist' / 'aws')
    candidates.append(ROOT / 'build' / 'venv' / 'bin' / 'aws')
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            version = _discover_version(candidate)
            if version:
                return version
    return None


def _discover_cfn_validate_version():
    pyproject = ROOT / 'pyproject.toml'
    if not pyproject.is_file():
        return None
    match = re.search(
        r'cloudformation-validate==([0-9][0-9A-Za-z.\-]*)',
        pyproject.read_text(encoding='utf-8', errors='replace'),
    )
    return match.group(1) if match else None


def _stream_and_tee(command, cwd, env, log_path):
    """Run a command, streaming combined output to stdout and a log file."""
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open('w', encoding='utf-8') as log:
        process = subprocess.Popen(
            command,
            cwd=str(cwd),
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        if process.stdout is not None:
            for line in process.stdout:
                sys.stdout.write(line)
                sys.stdout.flush()
                log.write(line)
            process.stdout.close()
        return process.wait()


def _augment_trial(result, rep, endpoint, run_id, transcripts_dir):
    trial = dict(result)
    trial['trial_index'] = rep
    trial['endpoint'] = endpoint
    trial['run_id'] = run_id
    name = trial.get('case') or f'trial-{rep}'
    source = trial.get('transcript_file')
    transcript_text = ''
    archived = None
    if source and Path(source).is_file():
        raw = Path(source).read_text(encoding='utf-8', errors='replace')
        transcript_text = _clean_transcript(raw)
        archived_path = transcripts_dir / f'rep-{rep:02d}-{name}.txt'
        archived_path.write_text(transcript_text, encoding='utf-8')
        archived = _rel_to_root(archived_path)
    # Supplementary engineering evidence: the raw stream-json events. Archive
    # them next to the human transcript before the current-transcripts scratch
    # directory is wiped at the end of the run.
    raw_source = trial.get('raw_events_file')
    archived_raw = None
    if raw_source and Path(raw_source).is_file():
        archived_raw_path = transcripts_dir / f'rep-{rep:02d}-{name}.jsonl'
        shutil.copy2(raw_source, archived_raw_path)
        archived_raw = _rel_to_root(archived_raw_path)
    trial.pop('transcript_file', None)
    trial.pop('raw_events_file', None)
    trial['transcript_text'] = transcript_text
    trial['archived_transcript'] = archived
    trial['archived_raw_events'] = archived_raw
    return trial


def _harness_command(args, results_path, current_transcript_dir, report_path):
    command = [
        sys.executable,
        str(HARNESS),
        '--strict',
        '--results-json',
        str(results_path),
        '--transcript-dir',
        str(current_transcript_dir),
        '--report',
        str(report_path),
        '--timeout',
        str(args.timeout),
    ]
    for case in args.cases:
        command += ['--case', case]
    if args.aws:
        command += ['--aws', args.aws]
    if args.kiro_cli:
        command += ['--kiro-cli', args.kiro_cli]
    if args.verbose:
        command.append('--verbose')
    return command


def _manifest_artifacts():
    """Harness plus every guarded agent profile, with SHA256s."""
    artifacts = {
        'harness': {
            'path': _rel_to_root(HARNESS),
            'sha256': _sha256_file(HARNESS) or 'unavailable',
        },
    }
    for condition in CONDITIONS:
        path = AGENT_DIR / f'{condition["agent"]}.json'
        key = 'agent_' + condition['agent'].replace('-', '_')
        artifacts[key] = {
            'path': _rel_to_root(path),
            'sha256': _sha256_file(path) or 'unavailable',
        }
    return artifacts


def _build_manifest(
    args,
    trials_doc,
    run_started,
    run_completed,
    harness_rcs,
    endpoints,
    collected,
    profile_restorations,
):
    aws_version = _discover_aws_version(args.aws)
    kiro_version = _discover_version(args.kiro_cli) if args.kiro_cli else None
    cfn_version = _discover_cfn_validate_version()
    return {
        'schema_version': SCHEMA_VERSION,
        'experiment': EXPERIMENT_NAME,
        'generated_at': trials_doc['generated_at'],
        'run_started_at': run_started,
        'run_completed_at': run_completed,
        'repetitions': args.repetitions,
        'cases': list(args.cases),
        'contexts': list(CONTEXTS),
        'trials_expected': (
            args.repetitions * len(args.cases) * len(CONTEXTS)
        ),
        'trials_collected': collected,
        'model': 'not exposed',
        'model_note': MODEL_NOTE,
        'provenance_available': True,
        'methodology': METHODOLOGY,
        'agent_profile_restoration_count': profile_restorations['total'],
        'agent_profile_restorations': profile_restorations,
        'versions': {
            'python': sys.version.split()[0],
            'aws_cli': aws_version or 'not exposed',
            'kiro_cli': kiro_version or 'not exposed',
            'cloudformation_validate': cfn_version or 'not discoverable',
        },
        'artifacts': _manifest_artifacts(),
        'harness_return_codes': harness_rcs,
        'endpoints': endpoints,
    }


def _build_and_write_report(
    trials_doc, manifest, report_path, output_dir=None
):
    """Validate the dataset, render Markdown, and write the report."""
    _validate_dataset(trials_doc)
    markdown_text = _render_report(trials_doc, manifest, output_dir)
    report_path.parent.mkdir(parents=True, exist_ok=True)
    report_path.write_text(markdown_text, encoding='utf-8')


def _terminal_rate(rate):
    numerator = rate['numerator']
    denominator = rate['denominator']
    if not denominator:
        return f'n/a ({numerator}/{denominator})'
    return f'{rate["percent"]:.1f}% ({numerator}/{denominator})'


def _terminal_stat(stats):
    if not stats['n']:
        return 'n/a (n=0)'
    return f'median {stats["median"]:.2f} (n={stats["n"]})'


def _print_run_plan(args):
    sessions = args.repetitions * len(args.cases) * len(CONTEXTS)
    output_mode = 'verbose Kiro stream' if args.verbose else 'concise progress'
    print('\n' + '=' * 78)
    print('AWS CLI VALIDATION AGENT EXPERIMENT')
    print('=' * 78)
    print(
        f'{sessions} sessions = {args.repetitions} repetitions × '
        f'{len(args.cases)} cases × {len(CONTEXTS)} conditions'
    )
    print(
        'Conditions: baseline | validate-only factual | validate-only guided'
    )
    print(f'Output: {output_mode}; use --verbose for full terminal detail.')
    print(f'Evidence: {args.output_dir}')
    print(f'Report:   {args.report}')
    print(
        'Safety: synthetic credentials and exact localhost endpoint on every '
        'observed/allowed AWS command path (not OS-level zero egress).'
    )
    print('=' * 78, flush=True)


def _print_report_instructions(report_path):
    report = Path(report_path).resolve()
    try:
        display_path = report.relative_to(ROOT)
    except ValueError:
        display_path = report
    print('\nMARKDOWN REPORT')
    print('-' * 78)
    print(f'  Report file: {report}')
    print(f'  Read with:   less {display_path}')


def _print_evidence_files(output_dir, report_path):
    """Point the reader at the full audit trail on disk."""
    output_dir = Path(output_dir)
    print('\nEVIDENCE FILES (full audit trail)')
    print(f'  Trials JSON:    {output_dir / "trials.json"}')
    print(f'  Manifest:       {output_dir / "manifest.json"}')
    print(f'  Transcripts:    {output_dir / "transcripts"}')
    print(f'  Raw results:    {output_dir / "raw"}')
    print(f'  Logs:           {output_dir / "logs"}')
    print(f'  Markdown report: {Path(report_path)}')


def _print_safety_status(signals, detailed=False):
    """Print one boundary verdict; expand individual signals only on demand."""
    status = (
        'PASS (boundary held)'
        if signals['boundary_held']
        else 'VIOLATION (boundary breached)'
    )
    print(
        '\nSAFETY — '
        f'{status}; observed/allowed AWS paths only, not OS-level zero egress.'
    )
    compact_names = (
        ('unsafe', 'unsafe'),
        ('non_synthetic', 'signer'),
        ('unattributed', 'unattributed'),
        ('validation_only_transport', 'val-http'),
        ('bypass', 'bypass'),
        ('nonlocal_endpoints', 'nonlocal'),
        ('infrastructure_failures', 'infra'),
        ('nonzero_kiro_rc', 'kiro'),
    )
    compact = ' '.join(
        f'{label}={signals[key]}' for key, label in compact_names
    )
    print(f'  {compact} restorations={signals["restorations"]}')
    if detailed:
        print(
            '  Across every observed agent AWS command, no real AWS '
            'credentials were used and no remote AWS service was called.'
        )
        for key, label, _desc in SAFETY_SIGNALS:
            print(f'  {label + ":":<34}{signals[key]}')
        print(
            f'  {"Agent-profile restorations:":<34}{signals["restorations"]}'
        )
        print(
            '  Report dataset validation: passed (fail-closed on unsafe, '
            'non-synthetic, unattributed, validation-only transport, '
            'non-loopback endpoint, and off-proxy bypass violations).'
        )
    print('=' * 78)


def _print_detailed_summary(trials_doc, trials, contexts):
    outcome_by_context = _compute_outcome_by_context(trials, contexts)
    behavior_by_context = _compute_behavior_by_context(trials, contexts)
    independent = _compute_independent_events(trials, contexts)
    diagnostic_observed = _compute_diagnostic_observed(trials, contexts)
    mechanism = _compute_mechanism(trials, contexts)
    efficiency = _compute_correction_efficiency(trials, contexts)
    signals = _compute_safety_signals(trials_doc, trials)

    print('\n' + '=' * 78)
    print('EXPERIMENT COMPLETE — OBSERVED RESULTS (verbose)')
    print('=' * 78)
    print(f'Sessions analyzed: {len(trials)}')
    print('Measured: after a cloudformation-validate diagnostic, whether the')
    print('agent revised the request and reached a clean validation or')
    print('success. Three conditions: baseline, validate-only factual,')
    print('validate-only guided. --validate-only always stops before')
    print('transport and reports CLEAN (exit 0) or FINDINGS (exit nonzero).')
    print('The mutually-exclusive outcome is over a fixed finding-scenario')
    print('denominator; independent events are reported separately so a')
    print('terminal outcome never hides an event that also occurred.')

    for ctx in contexts:
        data = outcome_by_context[ctx]
        eff = efficiency[ctx]
        behavior = behavior_by_context[ctx]
        events = independent[ctx]
        print(f'\n{_context_label(ctx).upper()}  [{ctx}]')
        print(f'  Finding-scenario denominator: {data["denominator"]}')
        print(
            '  Diagnostic observed:      '
            f'{_terminal_rate(diagnostic_observed[ctx])}'
        )
        for outcome in POST_DIAGNOSTIC_OUTCOMES:
            print(
                f'  {OUTCOME_LABELS[outcome] + ":":<35} '
                f'{_terminal_rate(data["outcomes"][outcome])}'
            )
        print('  Exclusive behavior path:')
        for path in BEHAVIOR_PATHS:
            print(
                f'    {BEHAVIOR_PATH_LABELS[path] + ":":<42} '
                f'{_terminal_rate(behavior["paths"][path])}'
            )
        print('  Independent events (non-exclusive):')
        for field, label in INDEPENDENT_EVENTS:
            print(f'    {label + ":":<50} {_terminal_rate(events[field])}')
        print(
            '  Correction attempted:     '
            f'{_terminal_rate(eff["correction_attempted"])}'
        )
        print(
            '  First correction clean:   '
            f'{_terminal_rate(eff["first_correction_clean"])}'
        )
        print(
            '  Calls to clean:           '
            f'{_terminal_stat(eff["calls_to_clean"])}'
        )

    print('\nMECHANISM: VALIDATION USE (secondary)')
    for ctx in contexts:
        print(
            f'  {_context_label(ctx)}: any validation-only '
            f'{_terminal_rate(mechanism[ctx]["validation_only"])}, '
            '--validate-only '
            f'{_terminal_rate(mechanism[ctx]["validate_only"])}'
        )

    _print_safety_status(signals, detailed=True)


def _print_compact_summary(trials_doc, trials, contexts):
    outcome_by_context = _compute_outcome_by_context(trials, contexts)
    behavior_by_context = _compute_behavior_by_context(trials, contexts)
    independent = _compute_independent_events(trials, contexts)
    diagnostic_observed = _compute_diagnostic_observed(trials, contexts)
    mechanism = _compute_mechanism(trials, contexts)
    signals = _compute_safety_signals(trials_doc, trials)

    print('\n' + '=' * 78)
    print('EXPERIMENT COMPLETE — OBSERVED RESULTS')
    print('=' * 78)
    print(
        f'Sessions analyzed: {len(trials)}. After a cloudformation-validate '
        'diagnostic, did the agent revise and reach a clean result? One row '
        'per condition over its fixed issue-producing test set (k/N, no '
        'CI). Run --verbose for the full breakdown; the Markdown report has '
        'the rest.'
    )
    header = (
        f'  {"cond":<8} {"findN":>5} {"diag":>6} {"clean":>6} '
        f'{"pre-fix":>7} {"blk>fix":>7} {"blk!fix":>7} {"hookblk":>7} '
        f'{"val-only":>8}'
    )
    print('')
    print(header)
    print('  ' + '-' * (len(header) - 2))
    for ctx in contexts:
        data = outcome_by_context[ctx]
        paths = behavior_by_context[ctx]['paths']
        print(
            f'  {_short_context_label(ctx):<8} '
            f'{data["denominator"]:>5} '
            f'{_kn(diagnostic_observed[ctx]):>6} '
            f'{_kn(data["outcomes"]["corrected-to-clean"]):>6} '
            f'{_kn(paths["fixed-before-live"]):>7} '
            f'{_kn(paths["blocked-then-fixed"]):>7} '
            f'{_kn(paths["blocked-not-fixed"]):>7} '
            f'{_kn(independent[ctx][HOOK_LOAD_BEARING_EVENT]):>7} '
            f'{_kn(mechanism[ctx]["validate_only"]):>8}'
        )
    print(
        '  cols: findN=finding scenarios, diag=diagnostic observed, '
        'clean=corrected-to-clean, pre-fix=fixed-before-live,'
    )
    print(
        '  blk>fix=hook-blocked-then-fixed, blk!fix=hook-blocked-not-fixed, '
        'hookblk=hook load-bearing, val-only=exact --validate-only.'
    )

    _print_safety_status(signals)


def _print_experiment_summary(
    trials_doc, report_path, output_dir, verbose=False
):
    trials = trials_doc.get('trials') or []
    contexts = _dataset_contexts(trials_doc)
    if verbose:
        _print_detailed_summary(trials_doc, trials, contexts)
    else:
        _print_compact_summary(trials_doc, trials, contexts)
    _print_evidence_files(output_dir, report_path)
    _print_report_instructions(report_path)


def _run_experiment(args):
    if not HARNESS.is_file():
        raise ExperimentError(f'harness not found: {HARNESS}')
    _preflight_profiles()

    _print_run_plan(args)
    output_dir = args.output_dir
    transcripts_dir = output_dir / 'transcripts'
    logs_dir = output_dir / 'logs'
    raw_dir = output_dir / 'raw'
    current_transcript_dir = output_dir / '.current-transcripts'
    for directory in (
        output_dir,
        transcripts_dir,
        logs_dir,
        raw_dir,
        current_transcript_dir,
    ):
        directory.mkdir(parents=True, exist_ok=True)

    guard = _make_profile_guard()
    within_session_restorations = 0
    run_started = _now_iso()
    all_trials = []
    harness_rcs = {}
    endpoints = {}
    for rep in range(1, args.repetitions + 1):
        results_path = raw_dir / f'rep-{rep:02d}-results.json'
        log_path = logs_dir / f'rep-{rep:02d}.log'
        report_path = raw_dir / f'rep-{rep:02d}-report.md'
        command = _harness_command(
            args, results_path, current_transcript_dir, report_path
        )
        print(f'\n=== repetition {rep}/{args.repetitions} ===', flush=True)
        # Restore the exact profile bytes before this harness starts so a
        # crashed prior harness cannot contaminate this repetition, and
        # again afterward even if the harness raised.
        guard.guarded_restore(f'before-repetition:{rep}')
        child_env = dict(os.environ)
        child_env['DEMO_S3_EXPERIMENT_MANAGED'] = '1'
        try:
            rc = _stream_and_tee(command, ROOT, child_env, log_path)
        finally:
            guard.guarded_restore(f'after-repetition:{rep}')
        harness_rcs[str(rep)] = rc
        if not results_path.is_file():
            raise ExperimentError(
                f'repetition {rep}: harness wrote no results JSON '
                f'({results_path}); see log {log_path}'
            )
        payload = json.loads(results_path.read_text(encoding='utf-8'))
        within_session_restorations += int(
            payload.get('agent_profile_restoration_count') or 0
        )
        endpoint = payload.get('endpoint')
        endpoints[str(rep)] = endpoint
        for result in payload.get('results', []):
            all_trials.append(
                _augment_trial(
                    result,
                    rep,
                    endpoint,
                    payload.get('run_id'),
                    transcripts_dir,
                )
            )
        if rc != 0:
            print(
                f'[warning] repetition {rep} harness exited {rc} under '
                '--strict; captured data is validated below',
                file=sys.stderr,
                flush=True,
            )
        expected_so_far = rep * len(args.cases) * len(CONTEXTS)
        print(
            f'--- repetition {rep}/{args.repetitions} complete: '
            f'{len(all_trials)}/{expected_so_far} sessions collected ---',
            flush=True,
        )
    shutil.rmtree(current_transcript_dir, ignore_errors=True)
    run_completed = _now_iso()

    between_repetition_restorations = guard.restoration_count
    profile_restorations = {
        'between_repetitions': between_repetition_restorations,
        'within_sessions': within_session_restorations,
        'total': (
            between_repetition_restorations + within_session_restorations
        ),
        'between_repetition_events': guard.restoration_events,
        'guard_available': True,
    }
    if profile_restorations['total']:
        print(
            '[profile-guard] Restored agent profiles to startup bytes '
            f'{profile_restorations["total"]} time(s) total '
            f'({between_repetition_restorations} between repetitions, '
            f'{within_session_restorations} within sessions).',
            flush=True,
        )
    else:
        print(
            '[profile-guard] Agent profiles were unchanged across the run; '
            'no restoration was necessary.',
            flush=True,
        )

    trials_doc = {
        'schema_version': SCHEMA_VERSION,
        'experiment': EXPERIMENT_NAME,
        'generated_at': _now_iso(),
        'repetitions': args.repetitions,
        'cases': list(args.cases),
        'contexts': list(CONTEXTS),
        'agent_profile_restoration_count': profile_restorations['total'],
        'trials': all_trials,
    }
    trials_path = output_dir / 'trials.json'
    trials_path.write_text(
        json.dumps(trials_doc, indent=2, sort_keys=True), encoding='utf-8'
    )

    manifest = _build_manifest(
        args,
        trials_doc,
        run_started,
        run_completed,
        harness_rcs,
        endpoints,
        len(all_trials),
        profile_restorations,
    )
    manifest_path = output_dir / 'manifest.json'
    manifest_path.write_text(
        json.dumps(manifest, indent=2, sort_keys=True), encoding='utf-8'
    )

    _build_and_write_report(trials_doc, manifest, args.report, args.output_dir)
    _print_experiment_summary(
        trials_doc, args.report, args.output_dir, verbose=args.verbose
    )
    return 0


def _generate_report_from_data(args):
    output_dir = args.output_dir
    trials_path = output_dir / 'trials.json'
    if not trials_path.is_file():
        raise ExperimentError(
            f'trials.json not found under {output_dir}; run without '
            '--from-data first, or point --output-dir at an existing dataset'
        )
    trials_doc = json.loads(trials_path.read_text(encoding='utf-8'))
    manifest_path = output_dir / 'manifest.json'
    if manifest_path.is_file():
        manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
    else:
        manifest = _synthesize_manifest(trials_doc)
    _build_and_write_report(trials_doc, manifest, args.report, args.output_dir)
    print(f'Markdown report regenerated from {trials_path}')
    _print_experiment_summary(
        trials_doc, args.report, args.output_dir, verbose=args.verbose
    )
    return 0


def _parse_args(argv):
    parser = argparse.ArgumentParser(
        prog=EXPERIMENT_NAME,
        description=(
            'Repeat scripts/demo-s3-agent-loop, aggregate the structured '
            'results into trials.json, and render a Markdown report with k/N '
            'rates and Wilson 95% confidence intervals.'
        ),
    )
    parser.add_argument(
        '--repetitions',
        type=int,
        default=3,
        help='Number of times to run the harness (default: 3).',
    )
    parser.add_argument(
        '--case',
        action='append',
        dest='cases',
        choices=KNOWN_CASES,
        metavar='CASE',
        help=(
            'Logical case to run; repeatable (default: '
            + ', '.join(DEFAULT_CASES)
            + ').'
        ),
    )
    parser.add_argument('--aws', help='Integrated AWS CLI executable path.')
    parser.add_argument(
        '--kiro-cli', dest='kiro_cli', help='Kiro CLI executable path.'
    )
    parser.add_argument(
        '--timeout',
        type=int,
        default=300,
        help='Per-session Kiro timeout in seconds (default: 300).',
    )
    parser.add_argument(
        '--output-dir',
        dest='output_dir',
        default=DEFAULT_OUTPUT_DIR,
        help=(
            'Directory for trials.json, manifest.json, transcripts, logs, '
            'and raw results (default: ' + DEFAULT_OUTPUT_DIR + '). Relative '
            'paths resolve against the repository root.'
        ),
    )
    parser.add_argument(
        '--report',
        default=DEFAULT_REPORT,
        help=(
            'Markdown report path (default: ' + DEFAULT_REPORT + '). '
            'Relative paths resolve against the repository root.'
        ),
    )
    parser.add_argument(
        '--from-data',
        dest='from_data',
        action='store_true',
        help=(
            'Regenerate the report from an existing '
            '<output-dir>/trials.json without running any sessions.'
        ),
    )
    parser.add_argument(
        '--verbose',
        action='store_true',
        help=(
            'Opt into detailed terminal output: stream full Kiro output '
            'from each session and print the full per-condition behavior '
            'summary. --verbose is also forwarded to the harness. The '
            'default relays concise per-session progress and prints a '
            'compact per-condition summary.'
        ),
    )
    args = parser.parse_args(argv)
    if args.repetitions < 1:
        parser.error('--repetitions must be a positive integer')
    if args.timeout < 1:
        parser.error('--timeout must be a positive integer')
    if args.cases:
        args.cases = list(dict.fromkeys(args.cases))
    else:
        args.cases = list(DEFAULT_CASES)
    args.output_dir = _resolve_repo_path(args.output_dir)
    args.report = _resolve_repo_path(args.report)
    return args


def main(argv=None):
    args = _parse_args(argv)
    try:
        if args.from_data:
            return _generate_report_from_data(args)
        return _run_experiment(args)
    except ExperimentError as error:
        print(f'error: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
