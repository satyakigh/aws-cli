SYNTHETIC_ACCESS_KEY_ID = 'AKIAIOSFODNN7DEMO001'

# Highest-to-lowest severity, matching the validator's ranking.
SEVERITY_ORDER = ('FATAL', 'ERROR', 'WARN', 'INFORMATIONAL')

# 95% two-sided normal quantile for Wilson score intervals.
WILSON_Z = 1.959963984540054

MODEL_NOTE = (
