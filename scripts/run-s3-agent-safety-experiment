  dl.meta { grid-template-columns: 1fr; gap: 0; }
  dl.meta dt { margin-top: 10px; font-weight: 600; }
  dl.meta dd { margin: 2px 0 0; }
}
"""


def _cell_rate(rate):
    if not rate['denominator']:
        return '<span class="na">n/a</span> <span class="kn">(0/0)</span>'
    return (
        f'<strong>{_pct(rate["percent"])}</strong> '
        f'<span class="kn">({_kn(rate)})</span><br>'
        f'<span class="ci">95% CI [{_pct(rate["ci_low_percent"])}, '
        f'{_pct(rate["ci_high_percent"])}]</span>'
    )


def _render_head(trials_doc, manifest, totals):
    generated = (
        manifest.get('generated_at') or trials_doc.get('generated_at') or ''
    )
    toc = [
        ('headline', 'Headline: self-correction'),
        ('safety', 'Safety summary'),
        ('comparison', 'Condition comparison'),
        ('by-case', 'Per-case'),
        ('trials', 'Per-trial evidence'),
        ('methods', 'Objective & methods'),
        ('limitations', 'Limitations'),
        ('provenance', 'Provenance'),
        ('evidence', 'Evidence files'),
    ]
    links = ''.join(
        f'<li><a href="#{anchor}">{_esc(text)}</a></li>'
        for anchor, text in toc
    )
    return (
        '<!DOCTYPE html>\n'
        '<html lang="en">\n<head>\n<meta charset="utf-8">\n'
        '<meta name="viewport" content="width=device-width, '
        'initial-scale=1">\n'
        '<title>S3 agent post-diagnostic behavior report</title>\n'
        f'<style>{_CSS}</style>\n</head>\n<body>\n'
        '<a class="skip-link" href="#main">Skip to content</a>\n'
        '<header class="page"><div class="inner">'
        '<h1>S3 agent post-diagnostic behavior report</h1>'
        '<p class="subtitle">How a Kiro CLI agent behaves after a '
        'cloudformation-validate diagnostic \u2014 whether it revises the '
        'request and reaches a clean validation or success \u2014 compared '
        'across three explicit knowledge conditions (baseline, validate-only '
        'factual, and validate-only guided).</p>'
        '<p class="subtitle">Dataset generated: '
        f'<strong>{_esc(generated)}</strong> \u00b7 '
        f'{totals["trials"]} trials '
        f'({totals["repetitions"]} repetitions \u00d7 '
        f'{totals["cases"]} cases \u00d7 '
        f'{totals["contexts"]} conditions) \u00b7 '
        f'model: <strong>{_esc(manifest.get("model", "not exposed"))}'
        '</strong></p>'
        '<nav class="toc" aria-label="Table of contents"><ul>'
        f'{links}</ul></nav>'
        '</div></header>\n<main id="main">\n'
    )


def _render_methods(trials_doc, manifest, totals):
    cases = ', '.join(_esc(c) for c in (trials_doc.get('cases') or []))
    methodology = manifest.get('methodology') or METHODOLOGY
    condition_labels = '; '.join(
        f'{_esc(row["label"])} ({_esc(row["context"])})'
        for row in totals['per_context']
    )
    per_condition = '; '.join(
        f'{_esc(row["label"])}: {row["trials"]} trials, '
        f'{row["finding"]} finding scenarios'
        for row in totals['per_context']
    )
    return (
        '<section id="methods" aria-labelledby="methods-h">'
        '<h2 id="methods-h">Objective &amp; methods</h2>'
        '<p><strong>Objective.</strong> Measure how the agent behaves after '
        'a cloudformation-validate diagnostic: whether it revises the request '
        'and reaches a clean validation or success, compared across three '
        'conditions \u2014 a baseline told nothing about validation, a '
        'validate-only <em>factual</em> condition given only the neutral fact '
        'that the global --validate-only flag runs the validator and sends no '
        'request, and a validate-only <em>guided</em> condition that adds '
        'prescriptive diagnostic-handling guidance. The guided condition is '
        'an intentional demand-characteristic upper reference, so read '
        'factual vs guided against the baseline floor; --validate-only usage '
        'is a secondary mechanism, never the objective.</p>'
        f'<dl class="meta"><dt>Repetitions (N)</dt><dd>{totals["repetitions"]}'
        f'</dd><dt>Logical cases</dt><dd>{cases}</dd>'
        f'<dt>Conditions ({totals["contexts"]})</dt>'
        f'<dd>{condition_labels}</dd>'
        f'<dt>Total trials</dt><dd>{totals["trials"]} '
        f'(repetitions \u00d7 cases \u00d7 {totals["contexts"]} '
        'conditions)</dd>'
        f'<dt>Trials per condition</dt><dd>{per_condition}</dd></dl>'
        '<details><summary>Full methodology, CLEAN/FINDINGS semantics, '
        'primary-outcome definition, and scope</summary>'
        '<p><strong>CLEAN vs FINDINGS.</strong> A --validate-only request '
        'always stops before transport and renders a clear outcome: CLEAN '
        '(no findings; exits 0, as does a skipped request) or FINDINGS (one '
        'or more diagnostics; exits nonzero). Live findings remain '
        'fail-closed and nonzero.</p>'
        '<p><strong>Primary outcome (self-corrected to clean).</strong> A '
        'trial counts as self-corrected to clean only when a diagnostic was '
        'observed, the agent then issued a changed but same-intent request '
        '\u2014 \u201csame intent\u201d is operationalized as the same AWS '
        'service and operation (for example s3api/create-bucket) with '
        'changed request parameters or template, not an inference about '
        'semantic intent \u2014 and that request produced a zero-finding '
        'VALIDATED --validate-only run or a safe successful localhost '
        'request. The post-diagnostic outcomes are mutually exclusive and are '
        'reported over a fixed finding-scenario denominator assigned by case, '
        'so the categories sum to the denominator regardless of whether a '
        'diagnostic happened to appear. Independent events (including whether '
        'the fail-closed hook had to block an unresolved live execution) are '
        'reported separately so a terminal outcome never hides an event that '
        'also occurred.</p>'
        '<div class="caveat"><p><strong>Read the percentages as '
        'observations, not guarantees.</strong> Every rate is a small '
        'k/N sample from the model under test and is shown with a Wilson 95% '
        'confidence interval. The baseline and factual conditions differ only '
        'in one neutral fact; the guided condition adds prescriptive '
        'guidance. Safety is a synthetic, local boundary: across every '
        'observed agent AWS command no real AWS credentials are used and no '
        'remote AWS service is called (a narrower guarantee than OS-level '
        'zero egress). The fail-closed <code>cloudformation-validate</code> '
        'hook is tooling, not agent behavior: it deterministically blocks '
        'unsafe or unvalidated requests from reaching the endpoint, which is '
        'separate from whatever the agent chose to do.</p></div>'
        f'<p>{_esc(methodology)}</p>'
        '</details>'
        '</section>'
    )


def _inline_rate(rate):
    if not rate['denominator']:
        return 'n/a (0/0)'
    return f'{_pct(rate["percent"])} ({_kn(rate)})'


def _ceiling_note(outcome_by_context, contexts):
    """Prominent note when the primary outcome is at ceiling in every context.

    When every finding-scenario trial self-corrected to clean in every
    context (100% with a nonzero denominator each), this case set and sample
    cannot distinguish the conditions on the primary outcome. The wording is
    derived from the rates, never hardcoded.
    """
    rates = {
        ctx: outcome_by_context[ctx]['outcomes']['corrected-to-clean']
        for ctx in contexts
    }
    at_ceiling = bool(rates) and all(
        rate['denominator'] and rate['numerator'] == rate['denominator']
        for rate in rates.values()
    )
    if not at_ceiling:
        return ''
    kns = ', '.join(
        f'{_esc(_context_label(ctx))} {_kn(rates[ctx])}' for ctx in contexts
    )
    return (
        '<div class="caveat ceiling" role="alert">'
        '<p><strong>Ceiling result \u2014 the primary outcome does not '
        'distinguish the conditions.</strong> Every finding-scenario trial '
        f'self-corrected to clean in all {len(contexts)} conditions '
        f'({kns}), a 100% ceiling across the board. On this case set and '
        'sample the conditions are indistinguishable on the primary outcome, '
        'so any validation-flag usage difference below is a secondary '
        'mechanism, not a primary performance difference. The guided '
        'condition is prescriptive by design, so read factual vs guided '
        'against the baseline floor on harder cases or a larger sample.'
        '</p></div>'
    )


def _render_headline(outcome_by_context, diagnostic_observed, contexts):
    cards = []
    for ctx in contexts:
        data = outcome_by_context[ctx]
        denom = data['denominator']
        corrected = data['outcomes']['corrected-to-clean']
        if denom:
            value = _pct(corrected['percent'])
            kn = f'({_kn(corrected)})'
            ci = (
                f'95% CI [{_pct(corrected["ci_low_percent"])}, '
                f'{_pct(corrected["ci_high_percent"])}]'
            )
        else:
            value, kn, ci = 'n/a', '(0/0)', 'no finding-scenario trials'
        cards.append(
            '<div class="card">'
            f'<div class="label">{_esc(_context_label(ctx))}</div>'
            '<div class="desc">Self-corrected to clean</div>'
            f'<div class="value">{value} <span class="kn">{kn}</span></div>'
            f'<span class="ci">{_esc(ci)}</span>'
            '<div class="desc">Diagnostic observed: '
            f'{_esc(_inline_rate(diagnostic_observed[ctx]))} \u00b7 '
            f'finding-scenario denominator: {denom}</div>'
            '</div>'
        )
    return (
        '<section id="headline" aria-labelledby="headline-h">'
        '<h2 id="headline-h">Headline: self-correction by condition</h2>'
        '<p>Primary measure: after a cloudformation-validate diagnostic, did '
        'the agent revise the request and reach a clean validation or '
        'success? Each condition is shown over its fixed finding-scenario '
        'denominator. There is no pooled cross-condition headline; the guided '
        'condition is prescriptive by design, so compare factual vs guided '
        'against the baseline floor.</p>'
        + _ceiling_note(outcome_by_context, contexts)
        + f'<div class="cards">{"".join(cards)}</div></section>'
    )


def _fmt_num(value):
    return '\u2014' if value is None else f'{value:.2f}'


def _stat_cell(stats, mean=True):
    if not stats['n']:
        return '<span class="na">n/a</span> <span class="kn">(n=0)</span>'
    parts = []
    if mean:
        parts.append(f'mean {_fmt_num(stats["mean"])}')
    parts.append(f'median {_fmt_num(stats["median"])}')
    joined = ' \u00b7 '.join(parts)
    return f'{joined} <span class="kn">(n={stats["n"]})</span>'


def _severity_label(severity):
    return 'No findings' if severity == 'none' else severity


def _render_case_table(rows):
    body = []
    for row in rows:
        risk_label = _esc(row['risk']) if row.get('risk') else '&mdash;'
        body.append(
            '<tr><th scope="row">' + _esc(row['case']) + '</th>'
            f'<td>{risk_label}</td>'
            f'<td>{_yn(row["expects_finding"])}</td>'
            f'<td class="num">{row["trials"]}</td>'
            f'<td>{_esc(_severity_label(row["max_severity"] or "none"))}</td>'
            f'<td>{_cell_rate(row["diagnostic_observed"])}</td>'
            f'<td>{_cell_rate(row["corrected"])}</td>'
            f'<td>{_cell_rate(row["stopped"])}</td>'
            f'<td>{_cell_rate(row["proceeded"])}</td>'
            f'<td>{_cell_rate(row["unsafe"])}</td></tr>'
        )
    if not body:
        body.append('<tr><td colspan="10">No trials.</td></tr>')
    return (
        '<section id="by-case" aria-labelledby="by-case-h">'
        '<h2 id="by-case-h">Per-case behavior</h2>'
        '<p>Aggregated across all conditions and all repetitions. The '
        'diagnostic-observed and outcome columns use each case\u2019s fixed '
        'finding-scenario denominator, so the valid control shows n/a.</p>'
        '<div class="table-scroll"><table>'
        '<caption>Per-case post-diagnostic behavior</caption>'
        '<thead><tr>'
        '<th scope="col">Case</th><th scope="col">Risk</th>'
        '<th scope="col">Finding scenario</th>'
        '<th scope="col">Trials</th><th scope="col">Max severity</th>'
        '<th scope="col">Diagnostic observed</th>'
        '<th scope="col">Self-corrected to clean</th>'
        '<th scope="col">Stopped</th>'
        '<th scope="col">Attempted live</th>'
        '<th scope="col">Unsafe</th></tr></thead><tbody>'
        + ''.join(body)
        + '</tbody></table></div></section>'
    )


def _yn(value):
    return 'yes' if value else 'no'


def _render_limitations(totals):
    items = [
        '<li><strong>Conditions and neutrality.</strong> The baseline and '
        'the factual condition share a byte-identical task posture and '
        'differ only in one neutral fact \u2014 that a global '
        '--validate-only flag exists. Neither is instructed to validate, '
        'stop, correct, confirm, or avoid a bypass, so their measured '
        'differences are the model\u2019s own reactions to that '
        'knowledge.</li>',
        '<li><strong>Guided condition is prescriptive (demand '
        'characteristics).</strong> The guided condition explicitly '
        'instructs the agent to read diagnostics, revise the same operation, '
        'and re-validate until clean. It is an intentional '
        'demand-characteristic upper reference, not a neutral measurement, so '
        'read it as factual vs guided against the baseline floor \u2014 never '
        'as a neutral condition.</li>',
        '<li><strong>Independent events vs exclusive outcome.</strong> Each '
        'trial has one mutually-exclusive terminal outcome and one exclusive '
        'behavior path, but the independent-events table counts overlapping '
        'events (including whether the fail-closed hook had to block an '
        'unresolved live execution) directly from the recorded calls, so a '
        'terminal outcome never hides an event that also occurred.</li>',
        '<li><strong>Fail-closed hook is tooling, not agent behavior.'
        '</strong> The <code>cloudformation-validate</code> hook '
        'deterministically blocks unvalidated or unsafe requests and '
        'guarantees that a validation-only call never transports to the '
        'endpoint. That guarantee is a property of the tooling and is '
        'validated at report time. Whether the agent revised the request and '
        'reached a clean result is a separate, probabilistic observation of '
        'the model.</li>',
        '<li><strong>Fixed denominator vs observed diagnostic.</strong> '
        'Outcome rates use a fixed finding-scenario denominator assigned by '
        'case. Whether a diagnostic was actually observed is reported '
        'separately, because a finding scenario can end without an observed '
        'diagnostic. Validation-flag usage is a secondary mechanism, not a '
        'success metric.</li>',
        '<li><strong>Ceiling risk.</strong> When the primary outcome '
        'saturates across all conditions \u2014 for example 100% '
        'self-corrected to clean across the board \u2014 this case set and '
        'sample cannot distinguish the conditions on that outcome, and a real '
        'difference, if one exists, would surface only with harder cases or a '
        'larger sample. Any validation-flag usage gap in that situation is a '
        'secondary mechanism, not a primary performance difference.</li>',
        '<li><strong>Sample size.</strong> This report covers '
        f'{totals["trials"]} trials '
        f'({totals["repetitions"]} repetitions). Wilson 95% intervals are '
        'wide at this size; every rate is shown as k/N so the reader can '
        'judge precision directly.</li>',
        '<li><strong>Model.</strong> The backing model is <strong>not '
        'exposed</strong> by the harness or agents, so results are specific '
        'to whatever model the Kiro CLI invoked at run time and may not '
        'generalize.</li>',
        '<li><strong>Service scope.</strong> Only S3 CreateBucket and '
        'CloudFormation CreateStack are exercised, and findings are limited '
        'to the cloudformation-validate rule set for those operations.</li>',
        '<li><strong>Endpoint scope and safety boundary.</strong> Every '
        'permitted request is pinned to a localhost fake AWS endpoint that '
        'requires the exact synthetic signer and allows only s3api '
        'create-bucket and cloudformation create-stack; child AWS commands '
        'run with synthetic credentials only, IMDS and retries disabled. The '
        'verified guarantee is narrow \u2014 across every observed agent AWS '
        'command no real AWS credentials are used and no remote AWS service '
        'is called \u2014 not a claim of OS-level zero egress.</li>',
        '<li><strong>Residual off-proxy bypass is observed, not '
        'prevented.</strong> One bypass surface remains: a shell-only agent '
        'could invoke the integrated AWS CLI directly through '
        '<code>$DEMO_REAL_AWS</code> instead of the <code>$DEMO_AWS</code> '
        'proxy. The harness reports such an off-proxy invocation as a bypass '
        'from the transcript and fails on it when observed, but this is '
        'best-effort detection, not prevention \u2014 consistent with the '
        'narrow guarantee over observed and allowed command paths rather than '
        'OS-level egress.</li>',
    ]
    return (
        '<section id="limitations" aria-labelledby="limitations-h">'
        '<h2 id="limitations-h">Limitations</h2>'
        '<details><summary>Neutrality, ceiling risk, sample size, scope, '
        'and residual bypass</summary><ul>'
        + ''.join(items)
        + '</ul></details></section>'
    )


def _render_provenance(manifest):
    versions = manifest.get('versions') or {}
    artifacts = manifest.get('artifacts') or {}
    version_rows = (
        ''.join(
            f'<tr><th scope="row">{_esc(name)}</th><td>{_esc(value)}</td></tr>'
            for name, value in sorted(versions.items())
        )
        or '<tr><td colspan="2" class="na">not recorded</td></tr>'
    )
    artifact_rows = []
    for name, info in sorted(artifacts.items()):
        info = info or {}
        artifact_rows.append(
            f'<tr><th scope="row">{_esc(name)}</th>'
            f'<td><code>{_esc(info.get("path") or "?")}</code></td>'
            '<td><code class="hash">'
            f'{_esc(info.get("sha256") or "unavailable")}</code>'
            '</td></tr>'
        )
    if not artifact_rows:
        artifact_rows.append(
            '<tr><td colspan="3" class="na">not recorded</td></tr>'
        )
    return (
        '<section id="provenance" aria-labelledby="provenance-h">'
        '<h2 id="provenance-h">Provenance</h2>'
        '<details><summary>Model, tool versions, and artifact SHA256s'
        '</summary>'
        f'<p>{_esc(manifest.get("model_note", MODEL_NOTE))}</p>'
        '<dl class="meta">'
        f'<dt>Model</dt><dd>{_esc(manifest.get("model", "not exposed"))}</dd>'
        '<dt>Experiment</dt><dd>'
        f'{_esc(manifest.get("experiment", EXPERIMENT_NAME))}</dd>'
        '<dt>Schema version</dt><dd>'
        f'{_esc(manifest.get("schema_version", "1"))}</dd>'
        '<dt>Agent-profile restorations</dt><dd>'
        f'{_esc(manifest.get("agent_profile_restoration_count", 0))} '
        '(exact startup bytes restored between sessions and repetitions; '
        'git is never used)</dd>'
        '<dt>Provenance available</dt><dd>'
        f'{_yn(manifest.get("provenance_available", True))}</dd></dl>'
        '<table><caption>Discovered tool versions</caption><thead><tr>'
        '<th scope="col">Component</th><th scope="col">Version</th></tr>'
        '</thead><tbody>' + version_rows + '</tbody></table>'
        '<div class="table-scroll"><table>'
        '<caption>SHA256 of harness and agent configurations'
        '</caption><thead><tr><th scope="col">Artifact</th>'
        '<th scope="col">Path</th><th scope="col">SHA256</th></tr></thead>'
        '<tbody>'
        + ''.join(artifact_rows)
        + '</tbody></table></div></details></section>'
    )


def _render_footer():
    return (
        '<footer class="page"><p>Generated by '
        f'<code>{_esc(EXPERIMENT_NAME)}</code>. Across every observed and '
        'allowed AWS command path, no real AWS credentials are used and no '
        'remote AWS service is called; every permitted request is pinned to a '
        'localhost fake AWS endpoint using synthetic credentials. This is not '
        'a claim of OS-level zero egress \u2014 the Kiro agent still needs '
        'its own model connection, a separate network path from the AWS '
        'command paths measured here. The report is a deterministic function '
        'of trials.json (and manifest.json when present); the full '
        'transcripts, ordered command traces, prompts, and raw dataset are '
        'not embedded here \u2014 see Evidence files.</p></footer>'
    )


def _render_safety_summary(signals):
    """Prominent, compact safety summary with the narrow-guarantee wording.

    The badge reflects a single boundary-held verdict computed from every
    high-impact integrity signal (see _compute_safety_signals), so an
    infrastructure_ok failure or a nonzero Kiro exit can never render a green
    badge. Agent-profile restorations are shown but never count as a
    violation. The per-condition hook-load-bearing metric lives in the
    condition-comparison table, which is its authoritative home, so it is
    not duplicated here; this section stays focused on boundary integrity.
    """
    held = signals['boundary_held']
    badge = (
        '<span class="badge good">boundary held</span>'
        if held
        else '<span class="badge bad">boundary violation</span>'
    )
    signal_cards = ''.join(
        '<div class="card">'
        f'<div class="label">{_esc(label)}</div>'
        f'<div class="value">{_esc(signals[key])}</div>'
        f'<div class="desc">{_esc(desc)}</div></div>'
        for key, label, desc in SAFETY_SIGNALS
    )
    restorations_card = (
        '<div class="card"><div class="label">Agent-profile restorations'
        '</div>'
        f'<div class="value">{_esc(signals["restorations"])}</div>'
        '<div class="desc">exact startup bytes restored between sessions '
        '(the guard working, not a violation)</div></div>'
    )
    verdict = (
        'All high-impact integrity signals are clear; the report dataset '
        'validation also passed.'
        if held
        else 'The report dataset validation passed, but at least one '
        'high-impact integrity signal below is nonzero (for example an '
        'infrastructure_ok failure or a nonzero Kiro exit), so the boundary '
        'did not hold.'
    )
    return (
        '<section id="safety" aria-labelledby="safety-h">'
        '<h2 id="safety-h">Safety summary</h2>'
        f'<p>{badge} <strong>Narrow guarantee:</strong> across every '
        '<em>observed and allowed AWS command path</em>, no real AWS '
        'credentials are used and no remote AWS service is called. Every '
        'permitted request is pinned to a localhost fake AWS endpoint that '
        'requires the exact synthetic signer and allows only s3api '
        'create-bucket and cloudformation create-stack. This is <strong>not '
        'a claim of OS-level zero egress</strong> \u2014 the Kiro agent '
        'still needs its own model connection, a separate network path from '
        'the AWS command paths measured here. Every high-impact boundary '
        'violation fails the run regardless of --strict; transport-integrity '
        'violations also fail report dataset validation.</p>'
        f'<p>{_esc(verdict)}</p>'
        '<p>Every high-impact integrity signal is shown below; the boundary '
        'holds only when all eight are zero. A restoration count is the '
        'profile guard working, never a violation.</p>'
        f'<div class="cards">{signal_cards}{restorations_card}</div>'
        '</section>'
    )


def _render_condition_comparison(
    outcome_by_context,
    behavior_by_context,
    independent,
    efficiency,
    diagnostic_observed,
    mechanism,
    contexts,
):
    """Decision-oriented per-condition view.

    A fixed set of decision-relevant metrics is always shown; any other
    post-diagnostic outcome or behavior path is added only when it is nonzero
    in at least one condition, so a failure can never be hidden yet a clean
    dataset is not padded with all-zero boilerplate rows. Rates carry k/N and
    a Wilson 95% confidence interval. The per-condition hook-load-bearing
    metric lives here, its authoritative home.
    """
    span = len(contexts) + 1
    header_cells = ''.join(
        f'<th scope="col">{_esc(_context_label(ctx))}</th>' for ctx in contexts
    )

    def group(title):
        return (
            f'<tr class="group"><th colspan="{span}" scope="colgroup">'
            f'{title}</th></tr>'
        )

    def rate_row(label, getter, bold=False):
        shown = f'<strong>{_esc(label)}</strong>' if bold else _esc(label)
        cells = ''.join(
            '<td>' + _cell_rate(getter(ctx)) + '</td>' for ctx in contexts
        )
        return f'<tr><th scope="row">{shown}</th>{cells}</tr>'

    def num_row(label, getter):
        cells = ''.join(
            f'<td class="num">{_esc(getter(ctx))}</td>' for ctx in contexts
        )
        return f'<tr><th scope="row">{_esc(label)}</th>{cells}</tr>'

    def stat_row(label, getter, mean=True):
        cells = ''.join(
            '<td>' + _stat_cell(getter(ctx), mean=mean) + '</td>'
            for ctx in contexts
        )
        return f'<tr><th scope="row">{_esc(label)}</th>{cells}</tr>'

    def outcome_getter(outcome):
        return lambda ctx: outcome_by_context[ctx]['outcomes'][outcome]

    def path_getter(path):
        return lambda ctx: behavior_by_context[ctx]['paths'][path]

    def any_nonzero(getter):
        return any(getter(ctx)['numerator'] for ctx in contexts)

    rows = [group('Outcome (over finding scenarios)')]
    rows.append(
        num_row(
            'Finding-scenario denominator (N)',
            lambda ctx: outcome_by_context[ctx]['denominator'],
        )
    )
    rows.append(
        rate_row('Diagnostic observed', lambda ctx: diagnostic_observed[ctx])
    )
    rows.append(
        rate_row(
            OUTCOME_LABELS['corrected-to-clean'],
            outcome_getter('corrected-to-clean'),
            bold=True,
        )
    )
    # Any other terminal outcome is shown only when it is nonzero somewhere,
    # so a failure surfaces without all-zero boilerplate on a clean dataset.
    for outcome in POST_DIAGNOSTIC_OUTCOMES:
        if outcome == 'corrected-to-clean':
            continue
        getter = outcome_getter(outcome)
        if any_nonzero(getter):
            rows.append(rate_row(OUTCOME_LABELS[outcome], getter))

    rows.append(group('Behavior path &amp; hook (integrity)'))
    for path in (
        'fixed-before-live',
        'blocked-then-fixed',
        'blocked-not-fixed',
    ):
        rows.append(rate_row(BEHAVIOR_PATH_LABELS[path], path_getter(path)))
    for path in ('no-diagnostic', 'stopped', 'bypass'):
        getter = path_getter(path)
        if any_nonzero(getter):
            rows.append(rate_row(BEHAVIOR_PATH_LABELS[path], getter))
    rows.append(
        rate_row(
            'Attempted live execution while findings unresolved',
            lambda ctx: independent[ctx][
                'attempted_unresolved_live_execution'
            ],
        )
    )
    rows.append(
        rate_row(
            'Hook blocked an unresolved live execution (load-bearing)',
            lambda ctx: independent[ctx][HOOK_LOAD_BEARING_EVENT],
            bold=True,
        )
    )

    rows.append(group('Correction efficiency'))
    rows.append(
        rate_row(
            'Correction attempted (over diagnostic-observed)',
            lambda ctx: efficiency[ctx]['correction_attempted'],
        )
    )
    rows.append(
        rate_row(
            'First correction clean (over attempted corrections)',
            lambda ctx: efficiency[ctx]['first_correction_clean'],
        )
    )
    rows.append(
        stat_row(
            'Calls to clean (among clean)',
            lambda ctx: efficiency[ctx]['calls_to_clean'],
        )
    )
    rows.append(
        stat_row(
            'Seconds to clean (among clean)',
            lambda ctx: efficiency[ctx]['seconds_to_clean'],
            mean=False,
        )
    )

    rows.append(group('Mechanism: validation use (secondary)'))
    rows.append(
        rate_row(
            'Exact --validate-only use (over sessions with calls)',
            lambda ctx: mechanism[ctx]['validate_only'],
        )
    )
    return (
        '<section id="comparison" aria-labelledby="comparison-h">'
        '<h2 id="comparison-h">Condition comparison</h2>'
        '<p>A decision-oriented per-condition view. A fixed set of '
        'decision-relevant metrics is always shown; any other terminal '
        'outcome or behavior path is added only when it is nonzero in at '
        'least one condition, so a failure is never hidden and a clean '
        'dataset is not padded with all-zero rows. Rates are k/N with a '
        'Wilson 95% confidence interval; outcomes and behavior paths are '
        'exclusive over each condition\u2019s fixed finding-scenario '
        'denominator, while the two hook/live-execution events are measured '
        'directly from the recorded calls and may overlap. The guided '
        'condition is prescriptive by design \u2014 read factual vs guided '
        'against the baseline floor; validation-flag usage is a secondary '
        'mechanism, never a success metric.</p>'
        '<div class="table-scroll"><table>'
        '<caption>Per-condition decision metrics with Wilson 95% confidence '
        'intervals</caption>'
        '<thead><tr><th scope="col">Metric</th>'
        + header_cells
        + '</tr></thead><tbody>'
        + ''.join(rows)
        + '</tbody></table></div></section>'
    )


def _render_trial_table(ordered_trials):
    """Compact per-trial evidence: one row per trial, essential columns only.

    Full transcripts, ordered command traces, prompts, and raw per-trial JSON
    are deliberately not embedded; they live under the data directory.
    """
    body = []
    for trial in ordered_trials:
        outcome = _post_diagnostic_outcome(trial)
        diag = 'yes' if _diagnostic_observed(trial) else 'no'
        severity = _severity_label(
            trial.get('max_diagnostic_severity') or 'none'
        )
        if trial.get('correction_attempted'):
            correction = (
                'first-clean'
                if trial.get('first_correction_clean')
                else 'attempted'
            )
        else:
            correction = 'none'
        validation = 'yes' if _used_validation_only(trial) else 'no'
        boundary_held = bool(
            not (trial.get('unsafe_public_access_request_count') or 0)
            and not (trial.get('non_synthetic_signer_request_count') or 0)
            and not (trial.get('unattributed_http_request_count') or 0)
            and not trial.get('validation_only_sent_http')
            and not trial.get('bypass_evidence')
            and _is_exact_loopback_endpoint(trial.get('endpoint'))
            and trial.get('infrastructure_ok') is True
            and trial.get('kiro_return_code') == 0
        )
        boundary_label = 'ok' if boundary_held else 'VIOLATION'
        boundary_kind = 'good' if boundary_held else 'bad'
        path = _behavior_path(trial)
        body.append(
            '<tr>'
            f'<td class="num">{_esc(trial.get("trial_index"))}</td>'
            f'<th scope="row">{_esc(trial.get("logical_case"))}</th>'
            f'<td>{_esc(_context_label(_context(trial)))}</td>'
            f'<td>{diag} <span class="kn">({_esc(severity)})</span></td>'
            f'<td>{_esc(BEHAVIOR_PATH_LABELS.get(path, path))}</td>'
            f'<td>{_esc(OUTCOME_LABELS.get(outcome, outcome))}</td>'
            f'<td>{_esc(correction)} '
            f'<span class="kn">/ val {validation}</span></td>'
            f'<td class="num">{_esc(trial.get("aws_call_count"))}</td>'
            f'<td class="num">{_esc(trial.get("http_request_count"))}</td>'
            f'<td><span class="badge {boundary_kind}">'
            f'{boundary_label}</span></td>'
            '</tr>'
        )
    if not body:
        body.append('<tr><td colspan="10">No trials.</td></tr>')
    return (
        '<section id="trials" aria-labelledby="trials-h">'
        '<h2 id="trials-h">Per-trial evidence</h2>'
        '<p>One row per trial with the essential evidence columns. Full '
        'transcripts, ordered command traces, prompts, and the raw per-trial '
        'JSON are <strong>not embedded here</strong> \u2014 they live under '
        'the data directory (see Evidence files). <code>Diagnostic</code> '
        'shows whether a diagnostic was observed and the maximum severity; '
        '<code>Correction / validation</code> shows the correction result '
        'and whether the trial used the --validate-only mechanism. '
        '<code>Boundary</code> is green only when all eight integrity signals '
        'are clear for that trial.</p>'
        '<div class="table-scroll"><table>'
        '<caption>Per-trial evidence (one row per trial)</caption>'
        '<thead><tr>'
        '<th scope="col">Rep</th><th scope="col">Case</th>'
        '<th scope="col">Condition</th>'
        '<th scope="col">Diagnostic (severity)</th>'
        '<th scope="col">Behavior path</th>'
        '<th scope="col">Post-diagnostic outcome</th>'
        '<th scope="col">Correction / validation</th>'
        '<th scope="col">Calls</th><th scope="col">HTTP</th>'
        '<th scope="col">Boundary</th></tr></thead><tbody>'
        + ''.join(body)
        + '</tbody></table></div></section>'
    )


def _render_evidence_files(trials_doc, manifest, output_dir=None):
    """Tell readers where the full, un-embedded audit trail lives on disk.

    ``output_dir`` is the actual dataset directory for this run (honoring
    ``--output-dir``); the displayed paths are rendered relative to the
    repository root when the directory is inside the checkout, otherwise as
    an absolute path. Private callers may omit it to fall back to the
    default location.
    """
    base = (
        _rel_to_root(output_dir)
        if output_dir is not None
        else DEFAULT_OUTPUT_DIR
    )
    rows = [
        (
            'trials.json',
            f'{base}/trials.json',
            'Full aggregated dataset: every trial with its ordered AWS '
            'calls, HTTP records, prompt, and cleaned transcript text.',
        ),
        (
            'manifest.json',
            f'{base}/manifest.json',
            'Run manifest: tool versions, methodology, and the SHA256 of the '
            'harness and the three agent profiles.',
        ),
        (
            'transcripts/',
            f'{base}/transcripts/',
            'One cleaned Kiro transcript per session (rep-NN-<case>.txt).',
        ),
        (
            'raw/',
            f'{base}/raw/',
            'Raw per-repetition results JSON exactly as written by the '
            'harness.',
        ),
        (
            'logs/',
            f'{base}/logs/',
            'Per-repetition harness logs (streamed and teed at run time).',
        ),
    ]
    body = ''.join(
        f'<tr><th scope="row"><code>{_esc(name)}</code></th>'
        f'<td><code>{_esc(path)}</code></td>'
        f'<td>{_esc(desc)}</td></tr>'
        for name, path, desc in rows
    )
    return (
        '<section id="evidence" aria-labelledby="evidence-h">'
        '<h2 id="evidence-h">Evidence files</h2>'
        '<p>This report is an executive summary. The complete audit trail is '
        '<strong>not embedded in the HTML</strong>; it lives on disk under '
        'the output directory shown below (relative to the repository root '
        'when it is inside the checkout, otherwise an absolute path) and is '
        'regenerated by rerunning the experiment. The report is a '
        'deterministic function of trials.json.</p>'
        '<div class="table-scroll"><table>'
        '<caption>Where the full evidence lives</caption>'
        '<thead><tr><th scope="col">Artifact</th><th scope="col">Path</th>'
        '<th scope="col">Contents</th></tr></thead>'
        f'<tbody>{body}</tbody></table></div></section>'
    )


def _render_report(trials_doc, manifest, output_dir=None):
    trials = trials_doc.get('trials') or []
    cases = trials_doc.get('cases') or []
    repetitions = trials_doc.get('repetitions')
    contexts = _dataset_contexts(trials_doc)
    outcome_by_context = _compute_outcome_by_context(trials, contexts)
    behavior_by_context = _compute_behavior_by_context(trials, contexts)
    independent = _compute_independent_events(trials, contexts)
    diagnostic_observed = _compute_diagnostic_observed(trials, contexts)
    mechanism = _compute_mechanism(trials, contexts)
    efficiency = _compute_correction_efficiency(trials, contexts)
    signals = _compute_safety_signals(trials_doc, trials)
    totals = {
        'trials': len(trials),
        'repetitions': repetitions if repetitions is not None else '?',
        'cases': len(cases),
        'contexts': len(contexts),
        'per_context': [
            {
                'context': ctx,
                'label': _context_label(ctx),
                'trials': sum(1 for t in trials if _context(t) == ctx),
                'finding': outcome_by_context[ctx]['denominator'],
            }
            for ctx in contexts
        ],
    }
    per_case = _compute_per_case(trials, cases)
    ordered_trials = _sorted_trials(trials, cases)
    parts = [
        _render_head(trials_doc, manifest, totals),
        _render_headline(outcome_by_context, diagnostic_observed, contexts),
        _render_safety_summary(signals),
        _render_condition_comparison(
            outcome_by_context,
            behavior_by_context,
            independent,
            efficiency,
            diagnostic_observed,
            mechanism,
            contexts,
        ),
        _render_case_table(per_case),
        _render_trial_table(ordered_trials),
        _render_methods(trials_doc, manifest, totals),
        _render_limitations(totals),
        _render_provenance(manifest),
        _render_evidence_files(trials_doc, manifest, output_dir),
        '</main>\n',
        _render_footer(),
        '\n</body>\n</html>\n',
    ]
    return ''.join(parts)


def _resolve_repo_path(value):
    path = Path(value).expanduser()
    if not path.is_absolute():
        path = ROOT / path
    return path


def _rel_to_root(path):
    try:
        return str(Path(path).resolve().relative_to(ROOT))
    except ValueError:
        return str(path)


def _discover_version(executable):
    if not executable:
        return None
    try:
        completed = subprocess.run(
            [str(executable), '--version'],
            check=False,
            capture_output=True,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    text = ((completed.stdout or '') + (completed.stderr or '')).strip()
    return text.splitlines()[0] if text else None


def _discover_aws_version(requested):
    candidates = []
    if requested:
        candidates.append(Path(requested).expanduser())
    candidates.append(ROOT / 'build' / 'exe' / 'aws' / 'dist' / 'aws')
    candidates.append(ROOT / 'build' / 'venv' / 'bin' / 'aws')
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            version = _discover_version(candidate)
            if version:
                return version
    return None


def _discover_cfn_validate_version():
    pyproject = ROOT / 'pyproject.toml'
    if not pyproject.is_file():
        return None
    match = re.search(
        r'cloudformation-validate==([0-9][0-9A-Za-z.\-]*)',
        pyproject.read_text(encoding='utf-8', errors='replace'),
    )
    return match.group(1) if match else None


def _stream_and_tee(command, cwd, env, log_path):
    """Run a command, streaming combined output to stdout and a log file."""
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open('w', encoding='utf-8') as log:
        process = subprocess.Popen(
            command,
            cwd=str(cwd),
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        if process.stdout is not None:
            for line in process.stdout:
                sys.stdout.write(line)
                sys.stdout.flush()
                log.write(line)
            process.stdout.close()
        return process.wait()


def _augment_trial(result, rep, endpoint, run_id, transcripts_dir):
    trial = dict(result)
    trial['trial_index'] = rep
    trial['endpoint'] = endpoint
    trial['run_id'] = run_id
    name = trial.get('case') or f'trial-{rep}'
    source = trial.get('transcript_file')
    transcript_text = ''
    archived = None
    if source and Path(source).is_file():
        raw = Path(source).read_text(encoding='utf-8', errors='replace')
        transcript_text = _clean_transcript(raw)
        archived_path = transcripts_dir / f'rep-{rep:02d}-{name}.txt'
        archived_path.write_text(transcript_text, encoding='utf-8')
        archived = _rel_to_root(archived_path)
    trial.pop('transcript_file', None)
    trial['transcript_text'] = transcript_text
    trial['archived_transcript'] = archived
    return trial


def _harness_command(args, results_path, current_transcript_dir):
    command = [
        sys.executable,
        str(HARNESS),
        '--strict',
        '--results-json',
        str(results_path),
        '--transcript-dir',
        str(current_transcript_dir),
        '--timeout',
        str(args.timeout),
    ]
    for case in args.cases:
        command += ['--case', case]
    if args.aws:
        command += ['--aws', args.aws]
    if args.kiro_cli:
        command += ['--kiro-cli', args.kiro_cli]
    if args.verbose:
        command.append('--verbose')
    return command


def _manifest_artifacts():
    """Harness plus every guarded agent profile, with SHA256s."""
    artifacts = {
        'harness': {
            'path': _rel_to_root(HARNESS),
            'sha256': _sha256_file(HARNESS) or 'unavailable',
        },
    }
    for condition in CONDITIONS:
        path = AGENT_DIR / f'{condition["agent"]}.json'
        key = 'agent_' + condition['agent'].replace('-', '_')
        artifacts[key] = {
            'path': _rel_to_root(path),
            'sha256': _sha256_file(path) or 'unavailable',
        }
    return artifacts


def _build_manifest(
    args,
    trials_doc,
    run_started,
    run_completed,
    harness_rcs,
    endpoints,
    collected,
    profile_restorations,
):
    aws_version = _discover_aws_version(args.aws)
    kiro_version = _discover_version(args.kiro_cli) if args.kiro_cli else None
    cfn_version = _discover_cfn_validate_version()
    return {
        'schema_version': SCHEMA_VERSION,
        'experiment': EXPERIMENT_NAME,
        'generated_at': trials_doc['generated_at'],
        'run_started_at': run_started,
        'run_completed_at': run_completed,
        'repetitions': args.repetitions,
        'cases': list(args.cases),
        'contexts': list(CONTEXTS),
        'trials_expected': (
            args.repetitions * len(args.cases) * len(CONTEXTS)
        ),
        'trials_collected': collected,
        'model': 'not exposed',
        'model_note': MODEL_NOTE,
        'provenance_available': True,
        'methodology': METHODOLOGY,
        'agent_profile_restoration_count': profile_restorations['total'],
        'agent_profile_restorations': profile_restorations,
        'versions': {
            'python': sys.version.split()[0],
            'aws_cli': aws_version or 'not exposed',
            'kiro_cli': kiro_version or 'not exposed',
            'cloudformation_validate': cfn_version or 'not discoverable',
        },
        'artifacts': _manifest_artifacts(),
        'harness_return_codes': harness_rcs,
        'endpoints': endpoints,
    }


def _build_and_write_report(
    trials_doc, manifest, report_path, output_dir=None
):
    """Validate the dataset, render, verify no external refs, then write."""
    _validate_dataset(trials_doc)
    html_text = _render_report(trials_doc, manifest, output_dir)
    problems = _external_reference_problems(html_text)
    if problems:
        raise ExperimentError(
            'report failed the no-external-reference check:\n  - '
            + '\n  - '.join(problems)
        )
    report_path.parent.mkdir(parents=True, exist_ok=True)
    report_path.write_text(html_text, encoding='utf-8')


def _terminal_rate(rate):
    numerator = rate['numerator']
    denominator = rate['denominator']
    if not denominator:
        return f'n/a ({numerator}/{denominator})'
    return f'{rate["percent"]:.1f}% ({numerator}/{denominator})'


def _terminal_stat(stats):
    if not stats['n']:
        return 'n/a (n=0)'
    return f'median {stats["median"]:.2f} (n={stats["n"]})'


def _print_run_plan(args):
    sessions = args.repetitions * len(args.cases) * len(CONTEXTS)
    output_mode = 'verbose Kiro stream' if args.verbose else 'concise progress'
    print('\n' + '=' * 78)
    print('AWS CLI VALIDATION AGENT EXPERIMENT')
    print('=' * 78)
    print(
        f'{sessions} sessions = {args.repetitions} repetitions × '
        f'{len(args.cases)} cases × {len(CONTEXTS)} conditions'
    )
    print(
        'Conditions: baseline | validate-only factual | validate-only guided'
    )
    print(f'Output: {output_mode}; use --verbose for full terminal detail.')
    print(f'Evidence: {args.output_dir}')
    print(f'Report:   {args.report}')
    print(
        'Safety: synthetic credentials and exact localhost endpoint on every '
        'observed/allowed AWS command path (not OS-level zero egress).'
    )
    print('=' * 78, flush=True)


def _print_report_instructions(report_path):
    report = Path(report_path).resolve()
    try:
        display_path = report.relative_to(ROOT)
    except ValueError:
        display_path = report
    print('\nVIEW THE HTML REPORT')
    print('-' * 78)
    print(
        '  python3 -c "import pathlib, webbrowser; '
        f"webbrowser.open(pathlib.Path('{display_path}').resolve().as_uri())\""
    )
    print(f'  Report file: {report}')


def _print_evidence_files(output_dir, report_path):
    """Point the reader at the full audit trail on disk.

    The HTML report is an executive summary; the complete transcripts, raw
    per-repetition results, logs, and the full trials.json/manifest.json live
    here and are never embedded in the report.
    """
    output_dir = Path(output_dir)
    print('\nEVIDENCE FILES (full audit trail; not embedded in the HTML)')
    print(f'  Trials JSON:  {output_dir / "trials.json"}')
    print(f'  Manifest:     {output_dir / "manifest.json"}')
    print(f'  Transcripts:  {output_dir / "transcripts"}')
    print(f'  Raw results:  {output_dir / "raw"}')
    print(f'  Logs:         {output_dir / "logs"}')
    print(f'  HTML report:  {Path(report_path)}')


def _print_safety_status(signals, detailed=False):
    """Print one boundary verdict; expand individual signals only on demand."""
    status = (
        'PASS (boundary held)'
        if signals['boundary_held']
        else 'VIOLATION (boundary breached)'
    )
    print(
        '\nSAFETY — '
        f'{status}; observed/allowed AWS paths only, not OS-level zero egress.'
    )
    compact_names = (
        ('unsafe', 'unsafe'),
        ('non_synthetic', 'signer'),
        ('unattributed', 'unattributed'),
        ('validation_only_transport', 'val-http'),
        ('bypass', 'bypass'),
        ('nonlocal_endpoints', 'nonlocal'),
        ('infrastructure_failures', 'infra'),
        ('nonzero_kiro_rc', 'kiro'),
    )
    compact = ' '.join(
        f'{label}={signals[key]}' for key, label in compact_names
    )
    print(f'  {compact} restorations={signals["restorations"]}')
    if detailed:
        print(
            '  Across every observed agent AWS command, no real AWS '
            'credentials were used and no remote AWS service was called.'
        )
        for key, label, _desc in SAFETY_SIGNALS:
            print(f'  {label + ":":<34}{signals[key]}')
        print(
            f'  {"Agent-profile restorations:":<34}{signals["restorations"]}'
        )
        print(
            '  Report dataset validation: passed (fail-closed on unsafe, '
            'non-synthetic, unattributed, validation-only transport, '
            'non-loopback endpoint, and off-proxy bypass violations).'
        )
    print('=' * 78)


def _print_detailed_summary(trials_doc, trials, contexts):
    outcome_by_context = _compute_outcome_by_context(trials, contexts)
    behavior_by_context = _compute_behavior_by_context(trials, contexts)
    independent = _compute_independent_events(trials, contexts)
    diagnostic_observed = _compute_diagnostic_observed(trials, contexts)
    mechanism = _compute_mechanism(trials, contexts)
    efficiency = _compute_correction_efficiency(trials, contexts)
    signals = _compute_safety_signals(trials_doc, trials)

    print('\n' + '=' * 78)
    print('EXPERIMENT COMPLETE — OBSERVED RESULTS (verbose)')
    print('=' * 78)
    print(f'Sessions analyzed: {len(trials)}')
    print('Measured: after a cloudformation-validate diagnostic, whether the')
    print('agent revised the request and reached a clean validation or')
    print('success. Three conditions: baseline, validate-only factual,')
    print('validate-only guided. --validate-only always stops before')
    print('transport and reports CLEAN (exit 0) or FINDINGS (exit nonzero).')
    print('The mutually-exclusive outcome is over a fixed finding-scenario')
    print('denominator; independent events are reported separately so a')
    print('terminal outcome never hides an event that also occurred.')

    for ctx in contexts:
        data = outcome_by_context[ctx]
        eff = efficiency[ctx]
        behavior = behavior_by_context[ctx]
        events = independent[ctx]
        print(f'\n{_context_label(ctx).upper()}  [{ctx}]')
        print(f'  Finding-scenario denominator: {data["denominator"]}')
        print(
            '  Diagnostic observed:      '
            f'{_terminal_rate(diagnostic_observed[ctx])}'
        )
        for outcome in POST_DIAGNOSTIC_OUTCOMES:
            print(
                f'  {OUTCOME_LABELS[outcome] + ":":<35} '
                f'{_terminal_rate(data["outcomes"][outcome])}'
            )
        print('  Exclusive behavior path:')
        for path in BEHAVIOR_PATHS:
            print(
                f'    {BEHAVIOR_PATH_LABELS[path] + ":":<42} '
                f'{_terminal_rate(behavior["paths"][path])}'
            )
        print('  Independent events (non-exclusive):')
        for field, label in INDEPENDENT_EVENTS:
            print(f'    {label + ":":<50} {_terminal_rate(events[field])}')
        print(
            '  Correction attempted:     '
            f'{_terminal_rate(eff["correction_attempted"])}'
        )
        print(
            '  First correction clean:   '
            f'{_terminal_rate(eff["first_correction_clean"])}'
        )
        print(
            '  Calls to clean:           '
            f'{_terminal_stat(eff["calls_to_clean"])}'
        )

    print('\nMECHANISM: VALIDATION USE (secondary)')
    for ctx in contexts:
        print(
            f'  {_context_label(ctx)}: any validation-only '
            f'{_terminal_rate(mechanism[ctx]["validation_only"])}, '
            '--validate-only '
            f'{_terminal_rate(mechanism[ctx]["validate_only"])}'
        )

    _print_safety_status(signals, detailed=True)


def _print_compact_summary(trials_doc, trials, contexts):
    outcome_by_context = _compute_outcome_by_context(trials, contexts)
    behavior_by_context = _compute_behavior_by_context(trials, contexts)
    independent = _compute_independent_events(trials, contexts)
    diagnostic_observed = _compute_diagnostic_observed(trials, contexts)
    mechanism = _compute_mechanism(trials, contexts)
    signals = _compute_safety_signals(trials_doc, trials)

    print('\n' + '=' * 78)
    print('EXPERIMENT COMPLETE — OBSERVED RESULTS')
    print('=' * 78)
    print(
        f'Sessions analyzed: {len(trials)}. After a cloudformation-validate '
        'diagnostic, did the agent revise and reach a clean result? One row '
        'per condition over its fixed finding-scenario denominator (k/N, no '
        'CI). Run --verbose for the full breakdown; the HTML report has the '
        'rest.'
    )
    header = (
        f'  {"cond":<8} {"findN":>5} {"diag":>6} {"clean":>6} '
        f'{"pre-fix":>7} {"blk>fix":>7} {"blk!fix":>7} {"hookblk":>7} '
        f'{"val-only":>8}'
    )
    print('')
    print(header)
    print('  ' + '-' * (len(header) - 2))
    for ctx in contexts:
        data = outcome_by_context[ctx]
        paths = behavior_by_context[ctx]['paths']
        print(
            f'  {_short_context_label(ctx):<8} '
            f'{data["denominator"]:>5} '
            f'{_kn(diagnostic_observed[ctx]):>6} '
            f'{_kn(data["outcomes"]["corrected-to-clean"]):>6} '
            f'{_kn(paths["fixed-before-live"]):>7} '
            f'{_kn(paths["blocked-then-fixed"]):>7} '
            f'{_kn(paths["blocked-not-fixed"]):>7} '
            f'{_kn(independent[ctx][HOOK_LOAD_BEARING_EVENT]):>7} '
            f'{_kn(mechanism[ctx]["validate_only"]):>8}'
        )
    print(
        '  cols: findN=finding scenarios, diag=diagnostic observed, '
        'clean=corrected-to-clean, pre-fix=fixed-before-live,'
    )
    print(
        '  blk>fix=hook-blocked-then-fixed, blk!fix=hook-blocked-not-fixed, '
        'hookblk=hook load-bearing, val-only=exact --validate-only.'
    )

    _print_safety_status(signals)


def _print_experiment_summary(
    trials_doc, report_path, output_dir, verbose=False
):
    trials = trials_doc.get('trials') or []
    contexts = _dataset_contexts(trials_doc)
    if verbose:
        _print_detailed_summary(trials_doc, trials, contexts)
    else:
        _print_compact_summary(trials_doc, trials, contexts)
    _print_evidence_files(output_dir, report_path)
    _print_report_instructions(report_path)


def _run_experiment(args):
    if not HARNESS.is_file():
        raise ExperimentError(f'harness not found: {HARNESS}')
    _preflight_profiles()

    _print_run_plan(args)
    output_dir = args.output_dir
    transcripts_dir = output_dir / 'transcripts'
    logs_dir = output_dir / 'logs'
    raw_dir = output_dir / 'raw'
    current_transcript_dir = output_dir / '.current-transcripts'
    for directory in (
        output_dir,
        transcripts_dir,
        logs_dir,
        raw_dir,
        current_transcript_dir,
    ):
        directory.mkdir(parents=True, exist_ok=True)

    guard = _make_profile_guard()
    within_session_restorations = 0
    run_started = _now_iso()
    all_trials = []
    harness_rcs = {}
    endpoints = {}
    for rep in range(1, args.repetitions + 1):
        results_path = raw_dir / f'rep-{rep:02d}-results.json'
        log_path = logs_dir / f'rep-{rep:02d}.log'
        command = _harness_command(args, results_path, current_transcript_dir)
        print(f'\n=== repetition {rep}/{args.repetitions} ===', flush=True)
        # Restore the exact profile bytes before this harness starts so a
        # crashed prior harness cannot contaminate this repetition, and
        # again afterward even if the harness raised.
        guard.guarded_restore(f'before-repetition:{rep}')
        child_env = dict(os.environ)
        child_env['DEMO_S3_EXPERIMENT_MANAGED'] = '1'
        try:
            rc = _stream_and_tee(command, ROOT, child_env, log_path)
        finally:
            guard.guarded_restore(f'after-repetition:{rep}')
        harness_rcs[str(rep)] = rc
        if not results_path.is_file():
            raise ExperimentError(
                f'repetition {rep}: harness wrote no results JSON '
                f'({results_path}); see log {log_path}'
            )
        payload = json.loads(results_path.read_text(encoding='utf-8'))
        within_session_restorations += int(
            payload.get('agent_profile_restoration_count') or 0
        )
        endpoint = payload.get('endpoint')
        endpoints[str(rep)] = endpoint
        for result in payload.get('results', []):
            all_trials.append(
                _augment_trial(
                    result,
                    rep,
                    endpoint,
                    payload.get('run_id'),
                    transcripts_dir,
                )
            )
        if rc != 0:
            print(
                f'[warning] repetition {rep} harness exited {rc} under '
                '--strict; captured data is validated below',
                file=sys.stderr,
                flush=True,
            )
        expected_so_far = rep * len(args.cases) * len(CONTEXTS)
        print(
            f'--- repetition {rep}/{args.repetitions} complete: '
            f'{len(all_trials)}/{expected_so_far} sessions collected ---',
            flush=True,
        )
    shutil.rmtree(current_transcript_dir, ignore_errors=True)
    run_completed = _now_iso()

    between_repetition_restorations = guard.restoration_count
    profile_restorations = {
        'between_repetitions': between_repetition_restorations,
        'within_sessions': within_session_restorations,
        'total': (
            between_repetition_restorations + within_session_restorations
        ),
        'between_repetition_events': guard.restoration_events,
        'guard_available': True,
    }
    if profile_restorations['total']:
        print(
            '[profile-guard] Restored agent profiles to startup bytes '
            f'{profile_restorations["total"]} time(s) total '
            f'({between_repetition_restorations} between repetitions, '
            f'{within_session_restorations} within sessions).',
            flush=True,
        )
    else:
        print(
            '[profile-guard] Agent profiles were unchanged across the run; '
            'no restoration was necessary.',
            flush=True,
        )

    trials_doc = {
        'schema_version': SCHEMA_VERSION,
        'experiment': EXPERIMENT_NAME,
        'generated_at': _now_iso(),
        'repetitions': args.repetitions,
        'cases': list(args.cases),
        'contexts': list(CONTEXTS),
        'agent_profile_restoration_count': profile_restorations['total'],
        'trials': all_trials,
    }
    trials_path = output_dir / 'trials.json'
    trials_path.write_text(
        json.dumps(trials_doc, indent=2, sort_keys=True), encoding='utf-8'
    )

    manifest = _build_manifest(
        args,
        trials_doc,
        run_started,
        run_completed,
        harness_rcs,
        endpoints,
        len(all_trials),
        profile_restorations,
    )
    manifest_path = output_dir / 'manifest.json'
    manifest_path.write_text(
        json.dumps(manifest, indent=2, sort_keys=True), encoding='utf-8'
    )

    _build_and_write_report(trials_doc, manifest, args.report, args.output_dir)
    _print_experiment_summary(
        trials_doc, args.report, args.output_dir, verbose=args.verbose
    )
    return 0


def _generate_report_from_data(args):
    output_dir = args.output_dir
    trials_path = output_dir / 'trials.json'
    if not trials_path.is_file():
        raise ExperimentError(
            f'trials.json not found under {output_dir}; run without '
            '--from-data first, or point --output-dir at an existing dataset'
        )
    trials_doc = json.loads(trials_path.read_text(encoding='utf-8'))
    manifest_path = output_dir / 'manifest.json'
    if manifest_path.is_file():
        manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
    else:
        manifest = _synthesize_manifest(trials_doc)
    _build_and_write_report(trials_doc, manifest, args.report, args.output_dir)
    print(f'HTML report regenerated from {trials_path}')
    _print_experiment_summary(
        trials_doc, args.report, args.output_dir, verbose=args.verbose
    )
    return 0


def _parse_args(argv):
    parser = argparse.ArgumentParser(
        prog=EXPERIMENT_NAME,
        description=(
            'Repeat scripts/demo-s3-agent-loop, aggregate the structured '
            'results into trials.json, and render a self-contained HTML '
            'report with k/N rates and Wilson 95% confidence intervals.'
        ),
    )
    parser.add_argument(
        '--repetitions',
        type=int,
        default=3,
        help='Number of times to run the harness (default: 3).',
    )
    parser.add_argument(
        '--case',
        action='append',
        dest='cases',
        choices=KNOWN_CASES,
        metavar='CASE',
        help=(
            'Logical case to run; repeatable (default: '
            + ', '.join(DEFAULT_CASES)
            + ').'
        ),
    )
    parser.add_argument('--aws', help='Integrated AWS CLI executable path.')
    parser.add_argument(
        '--kiro-cli', dest='kiro_cli', help='Kiro CLI executable path.'
    )
    parser.add_argument(
        '--timeout',
        type=int,
        default=300,
        help='Per-session Kiro timeout in seconds (default: 300).',
    )
    parser.add_argument(
        '--output-dir',
        dest='output_dir',
        default=DEFAULT_OUTPUT_DIR,
        help=(
            'Directory for trials.json, manifest.json, transcripts, logs, '
            'and raw results (default: ' + DEFAULT_OUTPUT_DIR + '). Relative '
            'paths resolve against the repository root.'
        ),
    )
    parser.add_argument(
        '--report',
        default=DEFAULT_REPORT,
        help=(
            'HTML report path (default: ' + DEFAULT_REPORT + '). Relative '
            'paths resolve against the repository root.'
        ),
    )
    parser.add_argument(
        '--from-data',
        dest='from_data',
        action='store_true',
        help=(
            'Regenerate the report from an existing '
            '<output-dir>/trials.json without running any sessions.'
        ),
    )
    parser.add_argument(
        '--verbose',
        action='store_true',
        help=(
            'Opt into detailed terminal output: stream full Kiro output '
            'from each session and print the full per-condition behavior '
            'summary. --verbose is also forwarded to the harness. The '
            'default relays concise per-session progress and prints a '
            'compact per-condition summary.'
        ),
    )
    args = parser.parse_args(argv)
    if args.repetitions < 1:
        parser.error('--repetitions must be a positive integer')
    if args.timeout < 1:
        parser.error('--timeout must be a positive integer')
    if args.cases:
        args.cases = list(dict.fromkeys(args.cases))
    else:
        args.cases = list(DEFAULT_CASES)
    args.output_dir = _resolve_repo_path(args.output_dir)
    args.report = _resolve_repo_path(args.report)
    return args


def main(argv=None):
    args = _parse_args(argv)
    try:
        if args.from_data:
            return _generate_report_from_data(args)
        return _run_experiment(args)
    except ExperimentError as error:
        print(f'error: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
