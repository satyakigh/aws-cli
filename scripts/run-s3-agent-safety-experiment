    'attempted-validation-bypass': 'Attempted validation bypass',
    'no-diagnostic-observed': 'No diagnostic observed',
}

# Exclusive behavior path derived from the independently-computed event
# fields (see scripts/demo-s3-agent-loop). Unlike the outcome above it
# foregrounds whether the fail-closed hook had to block an unresolved live
# execution. Every finding-scenario trial maps to exactly one path.
